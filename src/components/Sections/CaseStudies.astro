---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import csFintechImg from '../../assets/images/cs-fintech.jpg';
import csCloudImg from '../../assets/images/cs-cloud.jpg';
import csHealthcareImg from '../../assets/images/cs-healthcare.jpg';

const imageMap: Record<string, typeof csFintechImg> = {
  'ai-ml-platform': csFintechImg,
  'cloud-migration': csCloudImg,
  'digital-transformation': csHealthcareImg,
};

const entries = (await getCollection('case-studies')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const cases = entries.map(entry => ({
  tag: `${entry.data.industry} · ${entry.data.tag}`,
  client: entry.data.client,
  title: entry.data.title,
  excerpt: entry.data.excerpt,
  kpi: entry.data.kpi ?? entry.data.outcomes[0] ?? '',
  kpiLabel: entry.data.kpiLabel ?? '',
  href: `/case-studies/${entry.id}`,
  image: imageMap[entry.id] ?? csFintechImg,
}));
---

<section class="relative" aria-label="Case studies" id="case-studies-section" style="background: var(--t-bg-section); padding: 140px 0;">
  <div class="max-w-7xl mx-auto px-5 lg:px-12">
    <!-- Header row -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6" style="margin-bottom: 60px;">
      <div>
        <div class="font-mono text-[11px] tracking-[0.18em] uppercase text-accent-bright flex items-center gap-2.5 mb-6">
          <span style="opacity:0.7">02</span>
          <span class="inline-block w-6 h-px bg-current opacity-50"></span>
          <span>Case studies</span>
        </div>
        <h2
          class="font-display font-semibold leading-tight"
          style="font-size: clamp(36px, 5vw, 64px); letter-spacing: -0.035em; margin: 0; color: var(--t-heading);"
        >
          Outcomes, not output.
        </h2>
      </div>
      <a
        href="/case-studies"
        class="inline-flex items-center gap-2 text-sm font-semibold text-accent hover:text-accent-bright transition-colors shrink-0"
      >
        All case studies
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
        </svg>
      </a>
    </div>

    <!-- Featured card -->
    <div
      class="border grid grid-cols-1 lg:grid-cols-[1.4fr_1fr]"
      style="border-color: var(--t-border); min-height: 520px;"
      id="cs-featured"
    >
      <!-- Image col -->
      <div class="relative overflow-hidden min-h-[280px] lg:min-h-auto" style="background: var(--t-bg-image);" id="cs-img-col">
        {cases.map((cs, i) => (
          <div
            class={`absolute inset-0 transition-opacity duration-500 ${i === 0 ? '' : 'opacity-0'}`}
            data-cs-img={i}
          >
            <Image
              src={cs.image}
              alt=""
              aria-hidden="true"
              widths={[600, 1200]}
              sizes="(max-width: 1024px) 100vw, 55vw"
              width={1200}
              height={780}
              class="w-full h-full object-cover opacity-55"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
            <!-- Gradient: dark left edge for contrast, subtle blue tint across -->
            <div class="absolute inset-0" data-cs-img-overlay style="background: linear-gradient(105deg, rgba(6,11,23,0.55) 0%, rgba(20,120,200,0.18) 50%, rgba(6,11,23,0.25) 100%);"></div>
            <!-- Subtle grid -->
            <div class="absolute inset-0" style="background-image: linear-gradient(to right, rgba(255,255,255,0.04) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.04) 1px, transparent 1px); background-size: 48px 48px;"></div>
            <div class="absolute top-0 left-0 w-0.5 h-20 bg-accent-bright"></div>
            <div class="absolute bottom-8 left-8 font-mono text-[11px] tracking-[0.18em] uppercase text-white/70">
              {cs.tag}
            </div>
          </div>
        ))}
      </div>

      <!-- Content col -->
      <div id="cs-content-col" class="flex flex-col justify-between p-10 lg:p-14" style="background: var(--t-bg-card);">
        <div id="cs-content" style="display: grid;">
          {cases.map((cs, i) => (
            <div
              data-cs-content={i}
              style={`grid-area: 1 / 1; opacity: ${i === 0 ? 1 : 0}; pointer-events: ${i === 0 ? 'auto' : 'none'};`}
            >
              <div class="font-mono text-[11px] tracking-[0.18em] uppercase text-accent mb-5">
                {cs.client}
              </div>
              <h3
                class="font-display font-semibold mb-6"
                style="font-size: clamp(24px, 3vw, 38px); letter-spacing: -0.025em; line-height: 1.1; color: var(--t-heading);"
              >
                {cs.title}
              </h3>
              <p class="text-[15px] leading-relaxed mb-8" style="color: var(--t-body);">
                {cs.excerpt}
              </p>
            </div>
          ))}
        </div>
        <!-- KPI + CTA -->
        <div>
          <div class="pt-6 mb-7" style="border-top: 1px solid var(--t-border); display: grid;">
            {cases.map((cs, i) => (
              <div
                class="flex items-baseline gap-4"
                data-cs-kpi={i}
                style={`grid-area: 1 / 1; opacity: ${i === 0 ? 1 : 0}; pointer-events: ${i === 0 ? 'auto' : 'none'};`}
              >
                <span
                  class="font-display font-semibold text-accent"
                  style="font-size: 72px; line-height: 0.9; letter-spacing: -0.04em;"
                >
                  {cs.kpi}
                </span>
                <span class="font-mono text-[11px] tracking-[0.14em] uppercase pb-2" style="color: var(--t-muted);">
                  {cs.kpiLabel}
                </span>
              </div>
            ))}
          </div>
          <a
            href={cases[0]?.href ?? '/case-studies'}
            class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold border transition-colors rounded-sm"
            style="border-color: var(--t-border-strong); color: var(--t-heading);"
            id="cs-read-link"
          >
            Read the case
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Tab row -->
    <div
      class="grid border-l border-r border-b"
      style={`grid-template-columns: repeat(${cases.length}, 1fr); border-color: var(--t-border);`}
    >
      {cases.map((cs, i) => (
        <button
          class="text-left border-r last:border-0 transition-all duration-200 relative group"
          style={`border-color: var(--t-border); padding: 24px 28px; background: ${i === 0 ? 'rgba(20,120,200,0.08)' : 'transparent'}; cursor: pointer;`}
          data-cs-tab={i}
          data-cs-href={cs.href}
          aria-selected={i === 0 ? 'true' : 'false'}
        >
          <div
            class="absolute top-0 left-0 right-0 h-px transition-opacity duration-300"
            style={`background: linear-gradient(90deg, #2cb7e8, #1478c8); opacity: ${i === 0 ? '1' : '0'};`}
            data-cs-tab-bar={i}
          ></div>
          <div class="font-mono text-[10px] tracking-[0.16em] uppercase mb-2.5" style={`color: ${i === 0 ? 'rgba(44,183,232,0.8)' : 'var(--t-muted)'}; transition: color 0.2s;`}
            data-cs-tab-label={i}>
            0{i + 1} · {cs.tag}
          </div>
          <div class="text-[14px] font-semibold leading-snug" style={`color: ${i === 0 ? 'var(--t-heading)' : 'var(--t-body)'}; transition: color 0.2s;`}
            data-cs-tab-client={i}>
            {cs.client}
          </div>
        </button>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap, reducedMotion } from '../../lib/gsap.client';

  const tabs = document.querySelectorAll<HTMLElement>('[data-cs-tab]');
  const imgs = document.querySelectorAll<HTMLElement>('[data-cs-img]');
  const contents = document.querySelectorAll<HTMLElement>('[data-cs-content]');
  const kpis = document.querySelectorAll<HTMLElement>('[data-cs-kpi]');
  const bars = document.querySelectorAll<HTMLElement>('[data-cs-tab-bar]');
  const readLink = document.getElementById('cs-read-link') as HTMLAnchorElement | null;
  const tabLabels = document.querySelectorAll<HTMLElement>('[data-cs-tab-label]');
  const tabClients = document.querySelectorAll<HTMLElement>('[data-cs-tab-client]');

  let current = 0;
  let busy = false;

  function getTokens() {
    const cs = getComputedStyle(document.documentElement);
    return {
      heading: cs.getPropertyValue('--t-heading').trim(),
      body:    cs.getPropertyValue('--t-body').trim(),
      muted:   cs.getPropertyValue('--t-muted').trim(),
    };
  }

  function applyTabChrome(idx: number) {
    const { heading, body, muted } = getTokens();
    bars.forEach((el, i) => { el.style.opacity = i === idx ? '1' : '0'; });
    tabs.forEach((tab, i) => {
      const active = i === idx;
      tab.style.background = active ? 'rgba(20,120,200,0.08)' : 'transparent';
      tab.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    tabLabels.forEach((el, i) => {
      el.style.color = i === idx ? 'rgba(44,183,232,0.8)' : muted;
    });
    tabClients.forEach((el, i) => {
      el.style.color = i === idx ? heading : body;
    });
    if (readLink) readLink.href = tabs[idx]?.dataset.csHref ?? '#';
  }

  // Sync initial colors to current theme (SSR renders dark-mode values)
  applyTabChrome(current);
  document.addEventListener('theme-change', () => applyTabChrome(current));

  function switchTo(idx: number) {
    if (idx === current || busy) return;
    busy = true;

    const prevIdx = current;
    current = idx;

    // Image crossfade — CSS transition handles it
    imgs.forEach((el, i) => { el.style.opacity = i === idx ? '1' : '0'; });

    applyTabChrome(idx);

    const prevContent = contents[prevIdx];
    const prevKpi = kpis[prevIdx];
    const nextContent = contents[idx];
    const nextKpi = kpis[idx];

    if (reducedMotion) {
      prevContent.style.opacity = '0';
      prevContent.style.pointerEvents = 'none';
      prevKpi.style.opacity = '0';
      prevKpi.style.pointerEvents = 'none';
      nextContent.style.opacity = '1';
      nextContent.style.pointerEvents = 'auto';
      nextKpi.style.opacity = '1';
      nextKpi.style.pointerEvents = 'auto';
      busy = false;
      return;
    }

    // Disable pointer-events on both during transition
    [prevContent, prevKpi, nextContent, nextKpi].forEach(el => {
      el.style.pointerEvents = 'none';
    });

    // Fade-out current content + KPI
    gsap.to([prevContent, prevKpi], {
      opacity: 0,
      y: -16,
      duration: 0.22,
      ease: 'power2.in',
      onComplete: () => {
        gsap.set([prevContent, prevKpi], { y: 0 });

        gsap.fromTo(
          [nextContent, nextKpi],
          { opacity: 0, y: 18 },
          {
            opacity: 1,
            y: 0,
            duration: 0.4,
            ease: 'power3.out',
            onComplete: () => {
              nextContent.style.pointerEvents = 'auto';
              nextKpi.style.pointerEvents = 'auto';
              busy = false;
            },
          }
        );
      },
    });
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => switchTo(i));
  });
</script>
