---
import { industries } from '../../data/industries';
---

<section class="relative" style="background: #fff; padding: 140px 0 120px; overflow: hidden;" aria-label="Industries we serve">
  <!-- Diagonal divider from dark section above -->
  <svg style="position: absolute; top: -1px; left: 0; right: 0; width: 100%; height: 80px; display: block;" preserveAspectRatio="none" viewBox="0 0 100 10" aria-hidden="true">
    <polygon points="0,0 100,0 100,4 0,10" fill="#fff"/>
  </svg>

  <div style="max-width: 1440px; margin: 0 auto; padding: 0 48px; position: relative;">
    <!-- Header 2-col -->
    <div class="ind-header" style="align-items: end; margin-bottom: 72px;">
      <div>
        <!-- Eyebrow -->
        <div style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: #1478c8; display: flex; align-items: center; gap: 10px; margin-bottom: 24px;">
          <span style="opacity: 0.7;">01</span>
          <span style="width: 24px; height: 1px; background: currentColor; opacity: 0.5; display: inline-block;"></span>
          <span>Industries</span>
        </div>
        <h2 style="font-family: var(--font-display); font-size: 64px; line-height: 1; letter-spacing: -0.035em; font-weight: 600; margin: 0; color: #1a2b4a;">
          Six sectors.<br/>One standard.
        </h2>
      </div>
      <p style="font-size: 17px; line-height: 1.6; color: #445870; max-width: 560px;">
        We don't serve every market — we serve the ones where engineering discipline creates compounding advantage.
        Below are the industries where Anvil Prime teams are embedded today, running production systems for the companies that define them.
      </p>
    </div>

    <!-- 3-col grid using border-as-gap technique -->
    <div id="industries-grid" class="ind-grid" style="gap: 0; border: 1px solid #c8dff0; background: #c8dff0;">
      {industries.map((industry) => (
        <div data-industry-card style="background: #fff; padding: 40px; position: relative; min-height: 320px;">
          <!-- Top cyan hover bar -->
          <div data-ap-hover style="position: absolute; top: 0; left: 0; width: 48px; height: 2px; background: #2cb7e8; opacity: 0;"></div>

          <!-- Num + arrow row -->
          <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 28px;">
            <span style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.16em; color: #1478c8;">{industry.num}</span>
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
            </svg>
          </div>

          <!-- h3 name -->
          <h3 style="font-family: var(--font-display); font-size: 26px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.1; margin: 0 0 16px; color: #1a2b4a;">{industry.name}</h3>

          <!-- p description -->
          <p style="font-size: 14px; line-height: 1.55; color: #445870; margin: 0 0 36px;">{industry.description}</p>

          <!-- Stat row -->
          <div style="border-top: 1px solid #e2f2fb; padding-top: 20px; display: flex; align-items: baseline; gap: 12px;">
            <span style="font-family: var(--font-display); font-size: 40px; font-weight: 600; color: #1478c8; letter-spacing: -0.03em; line-height: 1;">{industry.stat}</span>
            <span style="font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.12em; color: #445870;">{industry.statLabel}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .ind-header {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 80px;
  }
  .ind-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  @media (max-width: 1024px) {
    .ind-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .ind-grid { grid-template-columns: 1fr; }
    .ind-header { grid-template-columns: 1fr; gap: 32px; }
  }
</style>

<script>
  import { gsap, reducedMotion, ScrollTrigger } from '../../lib/gsap.client';

  const grid = document.getElementById('industries-grid');
  if (!grid) throw new Error('industries-grid not found');

  const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-industry-card]'));

  if (reducedMotion) {
    // already visible, no animation needed
  } else {
    gsap.set(cards, { opacity: 0, y: 24 }); // initial hidden state

    const trigger = ScrollTrigger.create({
      trigger: grid,
      start: 'top 80%',
      once: true,
      onEnter: () => {
        gsap.to(cards, {
          opacity: 1,
          y: 0,
          stagger: 0.08,
          duration: 0.6,
          ease: 'power2.out',
        });
      },
    });

    document.addEventListener('astro:before-swap', () => trigger.kill(), { once: true });

    // 3D tilt on hover — desktop only (no touch)
    if (navigator.maxTouchPoints === 0) {
      grid.style.perspective = '800px';
      const controllers: AbortController[] = [];

      cards.forEach(card => {
        card.style.transformStyle = 'preserve-3d';

        const ac = new AbortController();
        controllers.push(ac);
        const { signal } = ac;
        const hoverBar = card.querySelector<HTMLElement>('[data-ap-hover]');

        card.addEventListener('mouseenter', () => {
          card.style.willChange = 'transform';
          if (hoverBar) gsap.to(hoverBar, { opacity: 1, duration: 0.2 });
          gsap.to(card, { backgroundColor: '#e8f1fa', duration: 0.2 });
        }, { signal });

        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const dx = (e.clientX - (rect.left + rect.width / 2)) / (rect.width / 2);
          const dy = (e.clientY - (rect.top + rect.height / 2)) / (rect.height / 2);
          gsap.to(card, { rotateX: -dy * 8, rotateY: dx * 8, duration: 0.3, ease: 'power2.out' });
        }, { signal });

        card.addEventListener('mouseleave', () => {
          if (hoverBar) gsap.to(hoverBar, { opacity: 0, duration: 0.2 });
          gsap.to(card, {
            rotateX: 0,
            rotateY: 0,
            backgroundColor: '#ffffff',
            duration: 0.5,
            ease: 'power2.out',
            onComplete: () => { card.style.willChange = 'auto'; },
          });
        }, { signal });
      });

      document.addEventListener('astro:before-swap', () => {
        controllers.forEach(ac => ac.abort());
      }, { once: true });
    }
  }
</script>
