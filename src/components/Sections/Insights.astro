---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import insightAiImg from '../../assets/images/insight-ai-enterprise.jpg';
import insightCloudImg from '../../assets/images/insight-cloud-native.jpg';
import insightEngineeringImg from '../../assets/images/insight-engineering-culture.jpg';

const imageMap: Record<string, typeof insightAiImg> = {
  'future-of-ai': insightAiImg,
  'cloud-native-patterns': insightCloudImg,
  'engineering-culture': insightEngineeringImg,
};

const entries = (await getCollection('insights')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const articles = entries.map(entry => ({
  tag: entry.data.category,
  date: entry.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' }),
  title: entry.data.title,
  author: `${entry.data.author.name}, ${entry.data.author.role}`,
  href: `/insights/${entry.id}`,
  image: imageMap[entry.id] ?? insightAiImg,
}));
---

<section class="relative overflow-hidden" aria-label="Insights and blog" style="background: var(--t-bg-section); color: var(--t-heading); padding: 140px 0;">
  <!-- Diagonal top divider — matches Performance section background with grid textures -->
  <div aria-hidden="true" style="position: absolute; top: 0; left: 0; right: 0; height: 80px; overflow: hidden;">
    <!-- Base fill -->
    <svg style="position: absolute; inset: 0; width: 100%; height: 100%;" preserveAspectRatio="none" viewBox="0 0 100 10">
      <polygon points="0,0 100,0 100,10 0,4" fill="#1478c8" />
    </svg>
    <!-- GridLines texture — same as Performance section -->
    <div data-poly-grid style="position: absolute; inset: 0; background-image: linear-gradient(to right, rgba(255,255,255,0.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.08) 1px, transparent 1px); background-size: 64px 64px; clip-path: polygon(0 0, 100% 0, 100% 100%, 0 40%);"></div>
    <!-- DotMatrix texture — same as Performance section -->
    <div data-poly-dots style="position: absolute; inset: 0; background-image: radial-gradient(rgba(255,255,255,0.12) 1.4px, transparent 1.4px); background-size: 28px 28px; clip-path: polygon(0 0, 100% 0, 100% 100%, 0 40%);"></div>
  </div>

  <div class="max-w-7xl mx-auto px-5 lg:px-12 relative">
    <!-- Header row -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6" style="margin-bottom: 60px;">
      <div>
        <div class="font-mono text-[11px] tracking-[0.18em] uppercase text-accent-bright flex items-center gap-2.5 mb-6">
          <span style="opacity:0.7">04</span>
          <span class="inline-block w-6 h-px bg-current opacity-50"></span>
          <span>Insights</span>
        </div>
        <h2
          class="font-display font-semibold leading-tight"
          style="font-size: clamp(36px, 5vw, 64px); letter-spacing: -0.035em; margin: 0; color: var(--t-heading);"
        >
          What we're learning.
        </h2>
      </div>
      <a
        href="/insights"
        class="inline-flex items-center gap-2 text-sm font-semibold text-accent hover:text-accent-bright transition-colors shrink-0"
      >
        All insights
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
        </svg>
      </a>
    </div>

    <!-- 3-col cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {articles.map((article) => (
        <a
          href={article.href}
          class="group flex flex-col border transition-transform duration-200 hover:-translate-y-1 relative"
          style="border-color: var(--t-border); background: var(--t-bg-card); min-height: 460px; text-decoration: none; color: inherit;"
        >
          <!-- Cyan accent bar — expands on hover -->
          <div
            class="absolute top-0 left-0 h-0.5 bg-accent-bright transition-all duration-300"
            style="width: 48px;"
            data-accent-bar
          ></div>

          <!-- Image -->
          <div class="h-48 overflow-hidden relative" data-insight-img-wrap>
            <Image
              src={article.image}
              alt=""
              aria-hidden="true"
              widths={[400, 800]}
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
              width={800}
              height={384}
              class="w-full h-full object-cover opacity-50 group-hover:opacity-70 transition-opacity duration-300"
              loading="lazy"
            />
          </div>

          <!-- Content -->
          <div class="p-7 flex flex-col flex-1">
            <div class="flex justify-between font-mono text-[10px] tracking-[0.16em] uppercase mb-4">
              <span class="text-accent">{article.tag}</span>
              <span style="color: var(--t-muted);">{article.date}</span>
            </div>
            <h3
              class="font-display font-semibold mb-auto"
              style="font-size: 22px; letter-spacing: -0.02em; line-height: 1.2; color: var(--t-heading);"
            >
              {article.title}
            </h3>
            <div class="mt-6 text-[13px]" style="color: var(--t-muted);">
              — {article.author}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-accent-bar]').forEach(bar => {
    const card = bar.closest('a');
    if (!card) return;
    card.addEventListener('mouseenter', () => { bar.style.width = '100%'; });
    card.addEventListener('mouseleave', () => { bar.style.width = '48px'; });
  });

  // Align polygon grid textures with the Performance section grid above.
  // Both grids use background-size: 64px / 28px. The polygon's background-position
  // defaults to 0,0 relative to itself — but the Performance section's grid also
  // starts at its own 0,0. We offset by the distance between sections mod the tile size.
  (function alignPolyGrid() {
    const perf = document.querySelector<HTMLElement>('section[aria-label="Company performance"]');
    const polyGrid = document.querySelector<HTMLElement>('[data-poly-grid]');
    const polyDots = document.querySelector<HTMLElement>('[data-poly-dots]');
    if (!perf || !polyGrid) return;

    const perfTop = perf.getBoundingClientRect().top + window.scrollY;
    const polyTop = polyGrid.getBoundingClientRect().top + window.scrollY;
    const delta = polyTop - perfTop;

    const gridOff = delta % 64;
    const dotOff  = delta % 28;

    polyGrid.style.backgroundPositionY = `-${gridOff}px`;
    if (polyDots) polyDots.style.backgroundPositionY = `-${dotOff}px`;
  })();
</script>
