---
const stats = [
  { value: '100%', countTo: 100, decimals: 0, prefix: '',  suffix: '%',  label: 'Senior engineers on every project', description: 'No juniors, no subcontractors on client work. Senior judgment on every decision, always.' },
  { value: '10+',  countTo: 10,  decimals: 0, prefix: '',  suffix: '+',  label: 'Years avg. engineering experience',  description: 'Deep, multi-domain expertise across data engineering, backend APIs, frontend, and AI-ready systems.' },
  { value: '48',   countTo: 48,  decimals: 0, prefix: '<', suffix: 'h',  label: 'Time to first working commit',      description: 'We start shipping in the first sprint. No lengthy onboarding. Working software from day one.' },
  { value: '8h+',  countTo: 8,   decimals: 0, prefix: '',  suffix: 'h+', label: 'U.S. time-zone overlap daily',      description: 'Our LATAM pods align fully with U.S. business hours. Real-time collaboration, not async delays.' },
];
---

<section
  aria-label="Company performance"
  style="background: #1478c8; padding: 140px 0 80px; position: relative; overflow: hidden;"
>
  <!-- GridLines texture -->
  <div
    aria-hidden="true"
    style="position: absolute; inset: 0; background-image: linear-gradient(to right, rgba(255,255,255,0.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.08) 1px, transparent 1px); background-size: 64px 64px; pointer-events: none;"
  ></div>

  <!-- DotMatrix texture -->
  <div
    aria-hidden="true"
    style="position: absolute; inset: 0; background-image: radial-gradient(rgba(255,255,255,0.12) 1.4px, transparent 1.4px); background-size: 28px 28px; pointer-events: none;"
  ></div>

  <!-- CrossMarks SVG -->
  <svg aria-hidden="true" style="position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none;">
    {[[80,60],[400,180],[900,100],[1280,280],[200,420]].map(([x,y]) => (
      <g transform={`translate(${x} ${y})`} stroke="rgba(255,255,255,0.35)" stroke-width="1">
        <line x1="-6" y1="0" x2="6" y2="0"/>
        <line x1="0" y1="-6" x2="0" y2="6"/>
      </g>
    ))}
  </svg>

  <!-- Content -->
  <div class="px-5 lg:px-12" style="max-width: 1440px; margin: 0 auto; position: relative; z-index: 2;">

    <!-- Header -->
    <div
      style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.7); display: flex; align-items: center; gap: 10px;"
    >
      <span style="opacity: 0.7;">03</span>
      <span style="width: 24px; height: 1px; background: currentColor; opacity: 0.5; display: inline-block;"></span>
      <span>Performance</span>
    </div>

    <h2
      data-perf-heading
      style="font-family: var(--font-display); font-size: 64px; line-height: 1; letter-spacing: -0.035em; font-weight: 600; color: #fff; max-width: 900px; margin-top: 24px; margin-bottom: 80px; opacity: 0; transform: translateY(24px);"
    >
      Senior engineers. Real ownership. No noise.
    </h2>

    <!-- Stats grid -->
    <div class="perf-grid" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 80px 96px;">
      {stats.map((stat, i) => (
        <div
          data-perf-stat
          style="position: relative; padding-top: 32px; border-top: 1px solid rgba(255,255,255,0.25); opacity: 0; transform: translateY(32px);"
        >
          <!-- Cyan accent bar — animated via GSAP scaleX 0→1 -->
          <div
            data-perf-bar
            style="position: absolute; top: -1px; left: 0; width: 48px; height: 2px; background: #2cb7e8; transform-origin: left center; transform: scaleX(0);"
          ></div>

          <!-- Index + label row -->
          <div style="display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.6); margin-bottom: 20px;">
            <span>0{i + 1}</span>
            <span>{stat.label}</span>
          </div>

          <!-- Massive number — all stats count up -->
          <div
            data-count-to={stat.countTo}
            data-count-decimals={stat.decimals}
            data-count-prefix={stat.prefix}
            data-count-suffix={stat.suffix}
            style="font-family: var(--font-display); font-size: clamp(100px, 12vw, 200px); line-height: 0.85; letter-spacing: -0.05em; font-weight: 600; color: #fff; margin: 0 0 20px;"
          >
            {stat.value}
          </div>

          <!-- Description -->
          <p style="font-size: 15px; line-height: 1.6; color: rgba(255,255,255,0.75); max-width: 420px; margin: 0;">
            {stat.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @media (max-width: 768px) {
    .perf-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>

<script>
  import { initCountUp } from '../Animations/CountUp.client';
  const section = document.querySelector('section[aria-label="Company performance"]') as HTMLElement | null;
  if (section) {
    const cleanup = initCountUp(section);
    document.addEventListener('astro:before-swap', cleanup, { once: true });
  }
</script>
