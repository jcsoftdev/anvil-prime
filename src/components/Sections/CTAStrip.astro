---
---

<section
  aria-label="Start a project"
  class="cta-section"
  style="background: #1a2b4a; padding: 100px 0; position: relative; overflow: hidden;"
>
  <!-- GridLines texture -->
  <div
    aria-hidden="true"
    style="position: absolute; inset: 0; background-image: linear-gradient(to right, rgba(255,255,255,0.04) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.04) 1px, transparent 1px); background-size: 64px 64px; pointer-events: none;"
  ></div>

  <!-- DotMatrix texture -->
  <div
    aria-hidden="true"
    style="position: absolute; inset: 0; background-image: radial-gradient(rgba(44,183,232,0.22) 1.2px, transparent 1.2px); background-size: 28px 28px; pointer-events: none;"
  ></div>

  <!-- Vertical cyan line -->
  <div
    aria-hidden="true"
    style="position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 2px; height: 80px; background: #2cb7e8;"
  ></div>

  <!-- Content -->
  <div class="cta-wrap">
    <div class="cta-inner">

      <!-- Left column -->
      <div>
        <div style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: #2cb7e8; margin-bottom: 20px;">
          Start a project
        </div>
        <h2 class="cta-heading" style="font-family: var(--font-display); line-height: 0.98; letter-spacing: -0.04em; font-weight: 600; margin: 0; color: #fff;">
          Have a system<br/>worth building?
        </h2>
      </div>

      <!-- Right column -->
      <div class="cta-body">
        <p style="font-size: 18px; line-height: 1.6; color: rgba(255,255,255,0.78); margin-bottom: 32px;">
          Most engagements begin with a 45-minute architecture review at no cost. We'll tell you honestly whether we're the right partner — and who to call if we aren't.
        </p>
        <div class="cta-btns" style="display: flex; gap: 12px; flex-wrap: wrap;">
          <a
            href="/contact"
            data-magnetic
            style="display: inline-flex; align-items: center; gap: 8px; padding: 14px 24px; background: #2cb7e8; color: #fff; font-family: var(--font-sans); font-weight: 600; font-size: 15px; text-decoration: none; border-radius: 2px; border: 1.5px solid #2cb7e8; transition: background 0.15s;"
          >
            Book the review
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
            </svg>
          </a>
          <a
            href="/about"
            style="display: inline-flex; align-items: center; gap: 8px; padding: 14px 24px; background: transparent; color: #fff; font-family: var(--font-sans); font-weight: 600; font-size: 15px; text-decoration: none; border-radius: 2px; border: 1.5px solid rgba(255,255,255,0.35); transition: background 0.15s, border-color 0.15s;"
          >
            Read our approach
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .cta-wrap {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
  }
  @media (min-width: 1024px) {
    .cta-wrap { padding: 0 48px; }
  }

  .cta-inner {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .cta-heading {
    font-size: clamp(40px, 6vw, 80px);
  }

  @media (max-width: 1024px) {
    .cta-inner {
      gap: 48px;
    }
  }

  @media (max-width: 768px) {
    .cta-section {
      padding: 64px 0 !important;
    }
    .cta-wrap {
      padding: 0 20px;
    }
    .cta-inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .cta-heading {
      font-size: clamp(36px, 10vw, 52px);
    }
    .cta-body p {
      font-size: 16px !important;
    }
    .cta-btns {
      flex-direction: column !important;
    }
    .cta-btns a {
      width: 100%;
      justify-content: center;
    }
  }
</style>
