---
import { SITE_NAME, CONTACT_EMAIL } from '../../utils/constants';

const currentYear = new Date().getFullYear();

const whatWeDo = [
  { label: 'Industry AI', href: '/services/industry-ai' },
  { label: 'Workflows AI', href: '/services/workflows-ai' },
  { label: 'SDLC AI', href: '/services/sdlc-ai' },
];

const industries = [
  { label: 'Media & Entertainment', href: '/industries/media-entertainment' },
  { label: 'Banking & Financial', href: '/industries/banking-financial-services' },
  { label: 'Healthcare', href: '/industries/healthcare-life-sciences' },
  { label: 'Retail & CPG', href: '/industries/retail-cpg' },
];
---

<footer class="bg-dark text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
      <!-- Brand -->
      <div class="md:col-span-1">
        <div class="font-bold text-xl mb-4">
          <span class="text-accent-dim">M</span>eridian Labs
        </div>
        <p class="text-subtle text-sm leading-relaxed max-w-xs">
          We help enterprises build better software, faster. From strategy to shipping.
        </p>
      </div>

      <!-- What We Do -->
      <div>
        <h2 class="font-semibold text-faint text-sm uppercase tracking-wider mb-4">What We Do</h2>
        <ul class="space-y-3 list-none m-0 p-0">
          {whatWeDo.map(link => (
            <li>
              <a href={link.href} class="text-subtle hover:text-white text-sm transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Industries -->
      <div>
        <h2 class="font-semibold text-faint text-sm uppercase tracking-wider mb-4">Industries</h2>
        <ul class="space-y-3 list-none m-0 p-0">
          {industries.map(link => (
            <li>
              <a href={link.href} class="text-subtle hover:text-white text-sm transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h2 class="font-semibold text-faint text-sm uppercase tracking-wider mb-4">Get In Touch</h2>
        <div class="space-y-3">
          <a href={`mailto:${CONTACT_EMAIL}`} class="block text-subtle hover:text-white text-sm transition-colors">{CONTACT_EMAIL}</a>
          <a href="/contact" class="block text-subtle hover:text-white text-sm transition-colors">Contact Us</a>
        </div>
      </div>
    </div>

    <div class="border-t border-border-dark pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-muted text-sm">© {currentYear} {SITE_NAME}. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="/privacy" class="text-muted hover:text-faint text-sm transition-colors">Privacy</a>
        <a href="/terms" class="text-muted hover:text-faint text-sm transition-colors">Terms</a>
      </div>
    </div>
  </div>
</footer>
