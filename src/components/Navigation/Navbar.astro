---
---

<header id="navbar" style="position: fixed; top: 0; left: 0; right: 0; z-index: 50;">
  <div style="max-width: 1440px; margin: 0 auto; padding: 0 48px; display: flex; align-items: center; height: 80px;">

    <!-- Logo -->
    <a href="/" aria-label="Anvil Prime home" style="display: flex; align-items: center; gap: 10px; color: white; text-decoration: none; flex-shrink: 0;">
      <svg width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <rect x="1" y="1" width="30" height="30" stroke="white" stroke-width="1.5"/>
        <rect x="6" y="6" width="20" height="20" fill="#1478c8"/>
        <rect x="6" y="6" width="20" height="4" fill="#2cb7e8"/>
        <line x1="1" y1="1" x2="31" y2="31" stroke="#2cb7e8" stroke-width="1" opacity="0.5"/>
      </svg>
      <span style="font-family: var(--font-display); font-size: 19px; font-weight: 600; letter-spacing: -0.02em; line-height: 1;">
        Anvil<span style="color: #2cb7e8;">Prime</span>
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden lg:flex" style="align-items: center; gap: 4px; margin-left: 12px;" aria-label="Main navigation">

      <!-- Services dropdown -->
      <div class="group" style="position: relative;">
        <button
          style="background: none; border: none; color: rgba(255,255,255,0.8); cursor: pointer; font-family: var(--font-sans); font-size: 14px; font-weight: 500; padding: 10px 14px; display: flex; align-items: center; gap: 6px;"
          class="hover:text-white transition-colors"
          aria-haspopup="true"
          aria-expanded="false"
        >
          Services
          <svg class="transition-transform group-hover:rotate-180" width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="absolute hidden group-hover:block group-focus-within:block" style="top: 100%; left: 0; padding-top: 12px;">
          <div style="position: relative; background: #0f1a30; border: 1px solid rgba(255,255,255,0.1); min-width: 380px; box-shadow: 0 24px 60px rgba(0,0,0,0.5);">
            <span aria-hidden="true" style="position: absolute; top: -1px; left: 0; width: 48px; height: 2px; background: #2cb7e8;"></span>
            <a href="/services/ai-data-platforms" style="display: block; padding: 12px 14px; color: white; text-decoration: none; border-bottom: 1px solid rgba(255,255,255,0.05);" class="hover:bg-[rgba(44,183,232,0.08)]">
              <div style="font-weight: 600; font-size: 14px; color: white;">AI &amp; Data Platforms</div>
              <div style="font-size: 12px; color: rgba(255,255,255,0.6); margin-top: 2px; line-height: 1.5;">Production LLM systems, MLOps, governance</div>
            </a>
            <a href="/services/cloud-modernization" style="display: block; padding: 12px 14px; color: white; text-decoration: none; border-bottom: 1px solid rgba(255,255,255,0.05);" class="hover:bg-[rgba(44,183,232,0.08)]">
              <div style="font-weight: 600; font-size: 14px; color: white;">Cloud Modernization</div>
              <div style="font-size: 12px; color: rgba(255,255,255,0.6); margin-top: 2px; line-height: 1.5;">Migration, FinOps, platform engineering</div>
            </a>
            <a href="/services/digital-engineering" style="display: block; padding: 12px 14px; color: white; text-decoration: none; border-bottom: 1px solid rgba(255,255,255,0.05);" class="hover:bg-[rgba(44,183,232,0.08)]">
              <div style="font-weight: 600; font-size: 14px; color: white;">Digital Engineering</div>
              <div style="font-size: 12px; color: rgba(255,255,255,0.6); margin-top: 2px; line-height: 1.5;">Product builds, design systems, delivery</div>
            </a>
            <a href="/services/cybersecurity" style="display: block; padding: 12px 14px; color: white; text-decoration: none;" class="hover:bg-[rgba(44,183,232,0.08)]">
              <div style="font-weight: 600; font-size: 14px; color: white;">Cybersecurity</div>
              <div style="font-size: 12px; color: rgba(255,255,255,0.6); margin-top: 2px; line-height: 1.5;">Zero-trust, compliance, incident response</div>
            </a>
          </div>
        </div>
      </div>

      <!-- Industries dropdown -->
      <div class="group" style="position: relative;">
        <button
          style="background: none; border: none; color: rgba(255,255,255,0.8); cursor: pointer; font-family: var(--font-sans); font-size: 14px; font-weight: 500; padding: 10px 14px; display: flex; align-items: center; gap: 6px;"
          class="hover:text-white transition-colors"
          aria-haspopup="true"
          aria-expanded="false"
        >
          Industries
          <svg class="transition-transform group-hover:rotate-180" width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="absolute hidden group-hover:block group-focus-within:block" style="top: 100%; left: 0; padding-top: 12px;">
          <div style="position: relative; background: #0f1a30; border: 1px solid rgba(255,255,255,0.1); min-width: 380px; box-shadow: 0 24px 60px rgba(0,0,0,0.5);">
            <span aria-hidden="true" style="position: absolute; top: -1px; left: 0; width: 48px; height: 2px; background: #2cb7e8;"></span>
            <a href="/industries/financial-services" style="display: block; padding: 12px 14px; color: white; text-decoration: none; border-bottom: 1px solid rgba(255,255,255,0.05);" class="hover:bg-[rgba(44,183,232,0.08)]">
              <div style="font-weight: 600; font-size: 14px; color: white;">Financial Services</div>
              <div style="font-size: 12px; color: rgba(255,255,255,0.6); margin-top: 2px; line-height: 1.5;">Banks, insurers, capital markets</div>
            </a>
            <a href="/industries/healthcare-life-sciences" style="display: block; padding: 12px 14px; color: white; text-decoration: none; border-bottom: 1px solid rgba(255,255,255,0.05);" class="hover:bg-[rgba(44,183,232,0.08)]">
              <div style="font-weight: 600; font-size: 14px; color: white;">Healthcare &amp; Life Sciences</div>
              <div style="font-size: 12px; color: rgba(255,255,255,0.6); margin-top: 2px; line-height: 1.5;">Payers, providers, biotech</div>
            </a>
            <a href="/industries/energy-industrial" style="display: block; padding: 12px 14px; color: white; text-decoration: none; border-bottom: 1px solid rgba(255,255,255,0.05);" class="hover:bg-[rgba(44,183,232,0.08)]">
              <div style="font-weight: 600; font-size: 14px; color: white;">Energy &amp; Industrial</div>
              <div style="font-size: 12px; color: rgba(255,255,255,0.6); margin-top: 2px; line-height: 1.5;">Utilities, manufacturing, supply chain</div>
            </a>
            <a href="/industries/public-sector" style="display: block; padding: 12px 14px; color: white; text-decoration: none;" class="hover:bg-[rgba(44,183,232,0.08)]">
              <div style="font-weight: 600; font-size: 14px; color: white;">Public Sector</div>
              <div style="font-size: 12px; color: rgba(255,255,255,0.6); margin-top: 2px; line-height: 1.5;">Federal, state, defense</div>
            </a>
          </div>
        </div>
      </div>

      <!-- Simple nav links -->
      <a href="/case-studies" style="color: rgba(255,255,255,0.8); font-size: 14px; font-weight: 500; padding: 10px 14px; text-decoration: none;" class="hover:text-white transition-colors">
        Case Studies
      </a>
      <a href="/insights" style="color: rgba(255,255,255,0.8); font-size: 14px; font-weight: 500; padding: 10px 14px; text-decoration: none;" class="hover:text-white transition-colors">
        Insights
      </a>
      <a href="/about" style="color: rgba(255,255,255,0.8); font-size: 14px; font-weight: 500; padding: 10px 14px; text-decoration: none;" class="hover:text-white transition-colors">
        About
      </a>
    </nav>

    <!-- Right side -->
    <div style="display: flex; align-items: center; gap: 12px; margin-left: auto;">
      <a
        href="/client-login"
        class="hidden lg:inline-flex hover:text-white hover:border-white/50 transition-colors"
        style="background: transparent; border: 1px solid rgba(255,255,255,0.25); color: rgba(255,255,255,0.8); font-size: 14px; font-weight: 600; padding: 8px 16px; text-decoration: none;"
      >
        Client login
      </a>
      <a
        href="/contact"
        data-magnetic
        class="hidden lg:inline-flex hover:bg-[#1478c8] transition-colors"
        style="background: #2cb7e8; color: white; font-size: 14px; font-weight: 600; padding: 8px 20px; text-decoration: none; border-radius: 2px;"
      >
        Start a project →
      </a>

      <!-- Hamburger -->
      <button
        id="mobile-menu-toggle"
        class="lg:hidden"
        style="background: none; border: none; color: rgba(255,255,255,0.8); cursor: pointer; padding: 8px;"
        aria-label="Toggle mobile menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden"
    style="background: #0b1322; border-top: 1px solid rgba(255,255,255,0.1);"
    role="navigation"
    aria-label="Mobile navigation"
  >
    <div style="padding: 16px 24px 24px;">
      <a href="/services" style="display: block; padding: 12px 0; color: rgba(255,255,255,0.8); text-decoration: none; font-weight: 600; font-size: 15px; border-bottom: 1px solid rgba(255,255,255,0.06);">Services</a>
      <a href="/services/ai-data-platforms" style="display: block; padding: 10px 16px; color: rgba(255,255,255,0.6); text-decoration: none; font-size: 14px;">AI &amp; Data Platforms</a>
      <a href="/services/cloud-modernization" style="display: block; padding: 10px 16px; color: rgba(255,255,255,0.6); text-decoration: none; font-size: 14px;">Cloud Modernization</a>
      <a href="/services/digital-engineering" style="display: block; padding: 10px 16px; color: rgba(255,255,255,0.6); text-decoration: none; font-size: 14px;">Digital Engineering</a>
      <a href="/services/cybersecurity" style="display: block; padding: 10px 16px; color: rgba(255,255,255,0.6); text-decoration: none; font-size: 14px; border-bottom: 1px solid rgba(255,255,255,0.06);">Cybersecurity</a>

      <a href="/industries" style="display: block; padding: 12px 0; color: rgba(255,255,255,0.8); text-decoration: none; font-weight: 600; font-size: 15px; border-bottom: 1px solid rgba(255,255,255,0.06);">Industries</a>
      <a href="/industries/financial-services" style="display: block; padding: 10px 16px; color: rgba(255,255,255,0.6); text-decoration: none; font-size: 14px;">Financial Services</a>
      <a href="/industries/healthcare-life-sciences" style="display: block; padding: 10px 16px; color: rgba(255,255,255,0.6); text-decoration: none; font-size: 14px;">Healthcare &amp; Life Sciences</a>
      <a href="/industries/energy-industrial" style="display: block; padding: 10px 16px; color: rgba(255,255,255,0.6); text-decoration: none; font-size: 14px;">Energy &amp; Industrial</a>
      <a href="/industries/public-sector" style="display: block; padding: 10px 16px; color: rgba(255,255,255,0.6); text-decoration: none; font-size: 14px; border-bottom: 1px solid rgba(255,255,255,0.06);">Public Sector</a>

      <a href="/case-studies" style="display: block; padding: 12px 0; color: rgba(255,255,255,0.8); text-decoration: none; font-weight: 600; font-size: 15px; border-bottom: 1px solid rgba(255,255,255,0.06);">Case Studies</a>
      <a href="/insights" style="display: block; padding: 12px 0; color: rgba(255,255,255,0.8); text-decoration: none; font-weight: 600; font-size: 15px; border-bottom: 1px solid rgba(255,255,255,0.06);">Insights</a>
      <a href="/about" style="display: block; padding: 12px 0; color: rgba(255,255,255,0.8); text-decoration: none; font-weight: 600; font-size: 15px; border-bottom: 1px solid rgba(255,255,255,0.06);">About</a>

      <div style="margin-top: 20px;">
        <a
          href="/contact"
          style="display: block; width: 100%; text-align: center; background: #2cb7e8; color: white; font-size: 15px; font-weight: 600; padding: 14px 20px; text-decoration: none; border-radius: 2px; box-sizing: border-box;"
        >
          Start a project →
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const navbar = document.getElementById('navbar');
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (navbar) {
    const onScroll = () => {
      const scrolled = window.scrollY > 20;
      navbar.style.background = scrolled ? 'rgba(11, 19, 34, 0.88)' : 'transparent';
      navbar.style.backdropFilter = scrolled ? 'blur(14px)' : 'none';
      (navbar.style as CSSStyleDeclaration & { WebkitBackdropFilter: string }).WebkitBackdropFilter = scrolled ? 'blur(14px)' : 'none';
      navbar.style.borderBottom = scrolled ? '1px solid rgba(255,255,255,0.1)' : '1px solid transparent';
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  if (toggle && menu) {
    let open = false;
    toggle.addEventListener('click', () => {
      open = !open;
      menu.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
    });
    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        open = false;
        menu.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open) {
        open = false;
        menu.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
