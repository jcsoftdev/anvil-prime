---
---

<header id="navbar" style="position: fixed; top: 0; left: 0; right: 0; z-index: 50;">
  <div class="px-5 lg:px-12" style="max-width: 1440px; margin: 0 auto; display: flex; align-items: center; height: 80px;">

    <!-- Logo -->
    <a href="/" aria-label="Anvil Prime home" style="display: flex; align-items: center; gap: 10px; color: white; text-decoration: none; flex-shrink: 0;">
      <img src="/favicon.png" alt="" width="40" height="40" aria-hidden="true" style="display: block; flex-shrink: 0;" />
      <span style="font-family: var(--font-display); font-size: 19px; font-weight: 600; letter-spacing: -0.02em; line-height: 1;">
        Anvil<span style="color: #2cb7e8;">Prime</span>
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden lg:flex" style="align-items: center; gap: 4px; margin-left: 12px;" aria-label="Main navigation">

      <!-- Services dropdown -->
      <div class="group" style="position: relative;">
        <button
          style="background: none; border: none; color: rgba(255,255,255,0.8); cursor: pointer; font-family: var(--font-sans); font-size: 14px; font-weight: 500; padding: 10px 14px; display: flex; align-items: center; gap: 6px;"
          class="hover:text-white transition-colors"
          aria-haspopup="true"
          aria-expanded="false"
        >
          Services
          <svg class="transition-transform group-hover:rotate-180" width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="absolute hidden group-hover:block group-focus-within:block" style="top: 100%; left: 0; padding-top: 12px;">
          <div style="position: relative; background: var(--t-bg-card); border: 1px solid var(--t-border); min-width: 380px; box-shadow: 0 12px 40px rgba(0,0,0,0.25);">
            <span aria-hidden="true" style="position: absolute; top: -1px; left: 0; width: 48px; height: 2px; background: #2cb7e8;"></span>
            <a href="/services/industry-ai" style="display: block; padding: 12px 14px; color: var(--t-heading); text-decoration: none; border-bottom: 1px solid var(--t-border);" class="hover:bg-[rgba(44,183,232,0.08)]">
              <div style="font-weight: 600; font-size: 14px; color: var(--t-heading);">Industry AI</div>
              <div style="font-size: 12px; color: var(--t-body); margin-top: 2px; line-height: 1.5;">Transforming industry-specific use cases with applied AI</div>
            </a>
            <a href="/services/workflows-ai" style="display: block; padding: 12px 14px; color: var(--t-heading); text-decoration: none; border-bottom: 1px solid var(--t-border);" class="hover:bg-[rgba(44,183,232,0.08)]">
              <div style="font-weight: 600; font-size: 14px; color: var(--t-heading);">Workflows AI</div>
              <div style="font-size: 12px; color: var(--t-body); margin-top: 2px; line-height: 1.5;">Agentic systems that unify workflows and multiply performance</div>
            </a>
            <a href="/services/sdlc-ai" style="display: block; padding: 12px 14px; color: var(--t-heading); text-decoration: none;" class="hover:bg-[rgba(44,183,232,0.08)]">
              <div style="font-weight: 600; font-size: 14px; color: var(--t-heading);">SDLC AI</div>
              <div style="font-size: 12px; color: var(--t-body); margin-top: 2px; line-height: 1.5;">Accelerating software engineering with agentic pods</div>
            </a>
          </div>
        </div>
      </div>

      <!-- Industries dropdown -->
      <div class="group" style="position: relative;">
        <button
          style="background: none; border: none; color: rgba(255,255,255,0.8); cursor: pointer; font-family: var(--font-sans); font-size: 14px; font-weight: 500; padding: 10px 14px; display: flex; align-items: center; gap: 6px;"
          class="hover:text-white transition-colors"
          aria-haspopup="true"
          aria-expanded="false"
        >
          Industries
          <svg class="transition-transform group-hover:rotate-180" width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="absolute hidden group-hover:block group-focus-within:block" style="top: 100%; left: 0; padding-top: 12px;">
          <div style="position: relative; background: var(--t-bg-card); border: 1px solid var(--t-border); min-width: 380px; box-shadow: 0 12px 40px rgba(0,0,0,0.25);">
            <span aria-hidden="true" style="position: absolute; top: -1px; left: 0; width: 48px; height: 2px; background: #2cb7e8;"></span>
            <a href="/industries/banking-financial-services" style="display: block; padding: 12px 14px; color: var(--t-heading); text-decoration: none; border-bottom: 1px solid var(--t-border);" class="hover:bg-[rgba(44,183,232,0.08)]">
              <div style="font-weight: 600; font-size: 14px; color: var(--t-heading);">Banking &amp; Financial Services</div>
              <div style="font-size: 12px; color: var(--t-body); margin-top: 2px; line-height: 1.5;">Neo/hybrid banking, document intelligence, financial workflows</div>
            </a>
            <a href="/industries/healthcare-life-sciences" style="display: block; padding: 12px 14px; color: var(--t-heading); text-decoration: none; border-bottom: 1px solid var(--t-border);" class="hover:bg-[rgba(44,183,232,0.08)]">
              <div style="font-weight: 600; font-size: 14px; color: var(--t-heading);">Healthcare &amp; Life Sciences</div>
              <div style="font-size: 12px; color: var(--t-body); margin-top: 2px; line-height: 1.5;">Preventative health, diagnostics, research, facility ops</div>
            </a>
            <a href="/industries/media-entertainment" style="display: block; padding: 12px 14px; color: var(--t-heading); text-decoration: none; border-bottom: 1px solid var(--t-border);" class="hover:bg-[rgba(44,183,232,0.08)]">
              <div style="font-weight: 600; font-size: 14px; color: var(--t-heading);">Media &amp; Entertainment</div>
              <div style="font-size: 12px; color: var(--t-body); margin-top: 2px; line-height: 1.5;">Media supply chain, content monetization, audience distribution</div>
            </a>
            <a href="/industries/retail-cpg" style="display: block; padding: 12px 14px; color: var(--t-heading); text-decoration: none;" class="hover:bg-[rgba(44,183,232,0.08)]">
              <div style="font-weight: 600; font-size: 14px; color: var(--t-heading);">Retail &amp; CPG</div>
              <div style="font-size: 12px; color: var(--t-body); margin-top: 2px; line-height: 1.5;">Supply chain optimization, forecasting, omni-channel retail</div>
            </a>
          </div>
        </div>
      </div>

      <!-- Simple nav links -->
      <a href="/case-studies" style="color: rgba(255,255,255,0.8); font-size: 14px; font-weight: 500; padding: 10px 14px; text-decoration: none;" class="hover:text-white transition-colors">
        Case Studies
      </a>
      <a href="/insights" style="color: rgba(255,255,255,0.8); font-size: 14px; font-weight: 500; padding: 10px 14px; text-decoration: none;" class="hover:text-white transition-colors">
        Insights
      </a>
      <a href="/about" style="color: rgba(255,255,255,0.8); font-size: 14px; font-weight: 500; padding: 10px 14px; text-decoration: none;" class="hover:text-white transition-colors">
        About
      </a>
    </nav>

    <!-- Right side -->
    <div style="display: flex; align-items: center; gap: 12px; margin-left: auto;">
      <!-- Theme toggle (desktop) -->
      <button
        id="theme-toggle"
        aria-label="Toggle light/dark mode"
        class="hidden lg:flex hover:border-white/50 transition-colors"
        style="background: transparent; border: 1px solid rgba(255,255,255,0.25); color: rgba(255,255,255,0.8); width: 36px; height: 36px; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0;"
      >
        <svg id="theme-icon-moon" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M13 9.5a5.5 5.5 0 01-6.5-6.5 5.5 5.5 0 106.5 6.5z"/>
        </svg>
        <svg id="theme-icon-sun" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="display:none;">
          <circle cx="8" cy="8" r="3.5" fill="currentColor"/>
          <g stroke="currentColor" stroke-width="1.2">
            <line x1="8" y1="1" x2="8" y2="3"/><line x1="8" y1="13" x2="8" y2="15"/>
            <line x1="1" y1="8" x2="3" y2="8"/><line x1="13" y1="8" x2="15" y2="8"/>
            <line x1="3" y1="3" x2="4.5" y2="4.5"/><line x1="11.5" y1="11.5" x2="13" y2="13"/>
            <line x1="3" y1="13" x2="4.5" y2="11.5"/><line x1="11.5" y1="4.5" x2="13" y2="3"/>
          </g>
        </svg>
      </button>

      <a
        href="/contact"
        data-nav-secondary
        class="hidden lg:inline-flex hover:text-white hover:border-white/50 transition-colors"
        style="background: transparent; border: 1px solid rgba(255,255,255,0.25); color: rgba(255,255,255,0.8); font-size: 14px; font-weight: 600; padding: 8px 16px; text-decoration: none;"
      >
        Client login
      </a>
      <a
        href="/contact"
        data-magnetic
        class="hidden lg:inline-flex hover:bg-[#1478c8] transition-colors"
        style="background: #2cb7e8; color: white; font-size: 14px; font-weight: 600; padding: 8px 20px; text-decoration: none; border-radius: 2px;"
      >
        Start a project →
      </a>

      <!-- Hamburger / Close -->
      <button
        id="mobile-menu-toggle"
        class="lg:hidden"
        style="background: none; border: none; color: rgba(255,255,255,0.8); cursor: pointer; padding: 8px; display: flex; align-items: center; justify-content: center;"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="nav-icon-hamburger" width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="nav-icon-close" width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" style="display: none;">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

  </div>
</header>

<!-- Mobile menu: full-screen overlay, z-40 (header bar stays above at z-50) -->
<div
  id="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile navigation"
  style="display: none; position: fixed; inset: 0; z-index: 40; background: var(--t-bg-card); overflow-y: auto;"
>
  <!-- Grid texture -->
  <div aria-hidden="true" style="position: absolute; inset: 0; background-image: linear-gradient(to right, rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 48px 48px; pointer-events: none;"></div>

  <!-- Content offset below 80px navbar bar -->
  <div style="position: relative; padding-top: 80px; min-height: 100%;">
    <div style="border-top: 1px solid var(--t-border); padding: 28px 20px 64px;">

      <!-- Services section -->
      <div class="mobile-nav-group">
        <span class="mobile-nav-label">Services</span>
        <a href="/services/industry-ai" class="mobile-nav-link">Industry AI</a>
        <a href="/services/workflows-ai" class="mobile-nav-link">Workflows AI</a>
        <a href="/services/sdlc-ai" class="mobile-nav-link">SDLC AI</a>
      </div>

      <!-- Industries section -->
      <div class="mobile-nav-group">
        <span class="mobile-nav-label">Industries</span>
        <a href="/industries/banking-financial-services" class="mobile-nav-link">Banking &amp; Financial Services</a>
        <a href="/industries/healthcare-life-sciences" class="mobile-nav-link">Healthcare &amp; Life Sciences</a>
        <a href="/industries/media-entertainment" class="mobile-nav-link">Media &amp; Entertainment</a>
        <a href="/industries/retail-cpg" class="mobile-nav-link">Retail &amp; CPG</a>
      </div>

      <!-- Primary links -->
      <div class="mobile-nav-group" style="margin-bottom: 36px;">
        <a href="/case-studies" class="mobile-nav-primary">Case Studies</a>
        <a href="/insights" class="mobile-nav-primary">Insights</a>
        <a href="/about" class="mobile-nav-primary">About</a>
      </div>

      <!-- CTAs -->
      <a href="/contact" style="display: block; text-align: center; background: #1478c8; color: white; font-size: 15px; font-weight: 600; padding: 15px 20px; text-decoration: none; margin-bottom: 10px; letter-spacing: 0.01em;">
        Start a project →
      </a>
      <a href="/contact" style="display: block; text-align: center; border: 1px solid var(--t-border); color: var(--t-body); font-size: 14px; font-weight: 500; padding: 13px 20px; text-decoration: none;">
        Client login
      </a>

    </div>
  </div>
</div>

<style>
  /* Mobile menu link styles */
  .mobile-nav-group { margin-bottom: 24px; }

  .mobile-nav-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #2cb7e8;
    padding-bottom: 10px;
    margin-bottom: 2px;
    border-bottom: 1px solid var(--t-border);
  }

  .mobile-nav-link {
    display: block;
    padding: 13px 0;
    color: var(--t-body);
    text-decoration: none;
    font-size: 16px;
    border-bottom: 1px solid var(--t-border);
    transition: color 0.15s;
  }
  .mobile-nav-link:hover { color: var(--t-heading); }

  .mobile-nav-primary {
    display: block;
    padding: 16px 0;
    color: var(--t-heading);
    text-decoration: none;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
    border-bottom: 1px solid var(--t-border);
    transition: color 0.15s;
  }
  .mobile-nav-primary:hover { color: #2cb7e8; }

  /* Force header legible over open menu in any theme */
  #navbar.menu-open a,
  #navbar.menu-open button { color: var(--t-heading) !important; }
  #navbar.menu-open .logo-mark rect:first-child { stroke: var(--t-heading) !important; }
</style>

<script>
  const navbar = document.getElementById('navbar');
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('nav-icon-hamburger');
  const closeIcon = document.getElementById('nav-icon-close');

  if (navbar) {
    const nav = navbar;
    const onScroll = () => {
      const scrolled = window.scrollY > 20;
      nav.classList.toggle('is-scrolled', scrolled);
      nav.style.background = scrolled ? 'var(--t-nav-scrolled-bg)' : 'transparent';
      nav.style.backdropFilter = scrolled ? 'blur(14px)' : 'none';
      (nav.style as CSSStyleDeclaration & { WebkitBackdropFilter: string }).WebkitBackdropFilter = scrolled ? 'blur(14px)' : 'none';
      nav.style.borderBottom = scrolled ? '1px solid var(--t-nav-scrolled-border)' : '1px solid transparent';
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    function updateNavHeroMode() {
      const isLight = document.documentElement.dataset.theme === 'light';
      if (!isLight) { nav.classList.remove('light-hero'); return; }
      const firstSection = document.querySelector<HTMLElement>('main > section:first-child, section:first-of-type');
      if (!firstSection) { nav.classList.add('light-hero'); return; }
      const bg = getComputedStyle(firstSection).backgroundColor;
      const nums = bg.match(/\d+/g)?.map(Number) ?? [0, 0, 0];
      const avg = (nums[0] + nums[1] + nums[2]) / 3;
      nav.classList.toggle('light-hero', avg > 80);
    }
    updateNavHeroMode();
    document.addEventListener('theme-change', updateNavHeroMode);
  }

  // Theme toggle
  const themeToggle = document.getElementById('theme-toggle');
  const moon = document.getElementById('theme-icon-moon');
  const sun = document.getElementById('theme-icon-sun');

  function applyTheme(theme: string) {
    if (theme === 'light') {
      document.documentElement.setAttribute('data-theme', 'light');
      if (moon) moon.style.display = 'none';
      if (sun) sun.style.display = '';
    } else {
      document.documentElement.removeAttribute('data-theme');
      if (moon) moon.style.display = '';
      if (sun) sun.style.display = 'none';
    }
    localStorage.setItem('ap-theme', theme);
    document.dispatchEvent(new Event('theme-change'));
  }

  if (localStorage.getItem('ap-theme') === 'light') {
    if (moon) moon.style.display = 'none';
    if (sun) sun.style.display = '';
  }

  themeToggle?.addEventListener('click', () => {
    const current = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
    applyTheme(current === 'light' ? 'dark' : 'light');
  });

  // Mobile menu open/close
  if (toggle && menu && navbar) {
    const btn = toggle;
    const overlay = menu;
    const nav = navbar;
    let open = false;

    function openMenu() {
      open = true;
      overlay.style.display = 'block';
      btn.setAttribute('aria-expanded', 'true');
      btn.setAttribute('aria-label', 'Close menu');
      if (hamburgerIcon) hamburgerIcon.style.display = 'none';
      if (closeIcon) closeIcon.style.display = '';
      nav.classList.add('menu-open');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      open = false;
      overlay.style.display = 'none';
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', 'Open menu');
      if (hamburgerIcon) hamburgerIcon.style.display = '';
      if (closeIcon) closeIcon.style.display = 'none';
      nav.classList.remove('menu-open');
      document.body.style.overflow = '';
    }

    btn.addEventListener('click', () => { open ? closeMenu() : openMenu(); });

    overlay.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open) closeMenu();
    });
  }
</script>
