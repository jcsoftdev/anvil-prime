    description: 'Engineering foundations for AI adoption, including structured data flows, service integrations, and scalable application support.',
  },
];
---

<Base title="Case Studies" description="Real results from real projects. See how Anvil Prime has helped companies build better software.">
  <Navbar />

  <!-- Page Header -->
  <section class="relative overflow-hidden" style="background: var(--t-bg-section);">
    <div class="absolute inset-0" aria-hidden="true" style="background-image: linear-gradient(to right, rgba(255,255,255,0.04) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.04) 1px, transparent 1px); background-size: 48px 48px;"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-5 lg:px-12 py-20 sm:py-24 lg:py-28">
      <div class="font-mono text-[11px] tracking-[0.18em] uppercase flex items-center gap-2.5 mb-6" style="color: #2cb7e8;">
        <span style="opacity:0.7">02</span>
        <span class="inline-block w-6 h-px bg-current opacity-50"></span>
        <span>Case Studies</span>
      </div>
      <h1 class="font-display font-semibold" style="font-size: clamp(36px, 5vw, 64px); letter-spacing: -0.035em; margin: 0 0 20px; color: var(--t-heading);">What We Build</h1>
      <p class="text-[17px]" style="color: var(--t-body);">A look at the kinds of systems we build for modern teams.</p>
    </div>
  </section>

  <!-- Capabilities Grid -->
  <section class="py-16 sm:py-20 lg:py-24" style="background: var(--t-bg-section);">
    <div class="max-w-7xl mx-auto px-5 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 border" style="border-color: var(--t-border);" id="cap-grid">
        {capabilities.map((cap, i) => (
          <div
            class={`flex flex-col sm:flex-row lg:odd:border-r ${i < 2 ? 'border-b' : ''}`}
            style="border-color: var(--t-border);"
            data-cap-card
          >
            <!-- SVG Illustration -->
            <div class="sm:w-[45%] shrink-0 min-h-[200px] sm:min-h-[260px] overflow-hidden" style="background: var(--illu-bg);" set:html={illustrations[cap.id]} />

            <!-- Content -->
            <div class="flex flex-col justify-center p-8 lg:p-10" style="background: var(--t-bg-card);">
              <div
                class="inline-flex items-center justify-center mb-6 shrink-0 self-start"
                style="width: 48px; height: 48px; border: 1px solid rgba(20,120,200,0.4); background: rgba(20,120,200,0.08); color: #2cb7e8; border-radius: 4px;"
                set:html={icons[cap.icon]}
              />
              <h2 class="font-display font-bold mb-3" style="font-size: clamp(18px, 2vw, 22px); letter-spacing: -0.02em; line-height: 1.2; color: var(--t-heading);">{cap.title}</h2>
              <p class="text-[14px] leading-relaxed" style="color: var(--t-body);">{cap.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    import { gsap, ScrollTrigger, reducedMotion } from '../../lib/gsap.client';

    const cards = document.querySelectorAll<HTMLElement>('[data-cap-card]');

    if (!reducedMotion && cards.length) {
      gsap.set(cards, { opacity: 0, y: 48 });

      ScrollTrigger.create({
        trigger: '#cap-grid',
        start: 'top 80%',
        once: true,
        onEnter: () => {
          gsap.to(cards, {
            opacity: 1,
            y: 0,
            duration: 0.7,
            ease: 'power3.out',
            stagger: 0.14,
          });
        },
      });
    }
  </script>
</Base>
