---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navigation/Navbar.astro';
import { caseStudyImages } from '../../data/post-images';

const studies = (await getCollection('case-studies')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Base title="Case Studies" description="Real results from real projects. See how Anvil Prime has helped companies build better software.">
  <Navbar />

  <!-- Page Header -->
  <section class="relative overflow-hidden" style="background: #060b17;">
    <div class="absolute inset-0" aria-hidden="true" style="background-image: linear-gradient(to right, rgba(255,255,255,0.04) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.04) 1px, transparent 1px); background-size: 48px 48px;"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-12 py-24 sm:py-32 lg:py-40">
      <div class="font-mono text-[11px] tracking-[0.18em] uppercase flex items-center gap-2.5 mb-6" style="color: #2cb7e8;">
        <span style="opacity:0.7">02</span>
        <span class="inline-block w-6 h-px bg-current opacity-50"></span>
        <span>Case Studies</span>
      </div>
      <h1 class="font-display font-semibold text-white" style="font-size: clamp(36px, 5vw, 64px); letter-spacing: -0.035em; margin: 0 0 20px;">Work We're Proud Of</h1>
      <p class="text-[17px]" style="color: rgba(255,255,255,0.65);">A sample of the enterprise projects we've shipped.</p>
    </div>
  </section>

  <!-- Card Grid -->
  <section class="py-16 sm:py-20 lg:py-24" style="background: #0b1322;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-12">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        {studies.map((study) => (
          <a href={`/case-studies/${study.id}`} class="group flex flex-col border transition-transform duration-200 hover:-translate-y-1 relative" style="border-color: rgba(255,255,255,0.08); background: #0b1322; text-decoration: none; color: inherit;">
            <div class="absolute top-0 left-0 h-0.5 transition-all duration-300" style="width: 48px; background: #2cb7e8;" data-accent-bar></div>
            <div class="h-40 sm:h-48 overflow-hidden">
              {caseStudyImages[study.id] && (
                <Image
                  src={caseStudyImages[study.id]}
                  alt=""
                  aria-hidden="true"
                  widths={[400, 800]}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                  width={800}
                  height={384}
                  class="w-full h-full object-cover opacity-50 group-hover:opacity-70 transition-opacity duration-300"
                  loading="lazy"
                />
              )}
            </div>
            <div class="p-7 flex flex-col flex-1">
              <div class="flex justify-between font-mono text-[10px] tracking-[0.16em] uppercase mb-4">
                <span style="color: #1478c8;">{study.data.tag}</span>
                <span style="color: rgba(255,255,255,0.45);">{study.data.industry}</span>
              </div>
              <h2 class="font-display font-semibold text-white mb-3" style="font-size: 20px; letter-spacing: -0.02em; line-height: 1.2;">{study.data.title}</h2>
              <p class="text-[13px] leading-relaxed" style="color: rgba(255,255,255,0.55);">{study.data.excerpt}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <script>
    document.querySelectorAll('[data-accent-bar]').forEach(bar => {
      const card = bar.closest('a');
      if (!card) return;
      card.addEventListener('mouseenter', () => { (bar as HTMLElement).style.width = '100%'; });
      card.addEventListener('mouseleave', () => { (bar as HTMLElement).style.width = '48px'; });
    });
  </script>
</Base>
