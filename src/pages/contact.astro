---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navigation/Navbar.astro';
import { CONTACT_EMAIL } from '../utils/constants';
import contactBg from '../assets/images/contact.jpg';

const industries = ['Media & Entertainment', 'Banking, Financial Services & Insurance', 'Healthcare & Life Sciences', 'Retail & CPG', 'Other'];
const interests = ['Industry AI', 'Workflows AI', 'SDLC AI', 'Staff Augmentation', 'Advisory / Strategy', 'Not sure yet'];

const autofill = Astro.url.searchParams.get('autofill') === 'true';
const prefill = autofill ? {
  first_name: 'Jane',
  last_name:  'Smith',
  email:      'jane.smith@acmecorp.com',
  company:    'Acme Corp',
  job_title:  'VP of Engineering',
  country:    'United States',
  industry:   'Healthcare & Life Sciences',
  interest:   'SDLC AI',
  notes:      'We are looking to accelerate our development lifecycle using AI tooling. Currently running 4 squads and shipping every 2 weeks.',
} : {
  first_name: '', last_name: '', email: '', company: '',
  job_title: '', country: '', industry: '', interest: '', notes: '',
};
---

<Base title="Contact" description="Talk to the Anvil Prime team about your next AI project.">
  <Navbar />
  <main class="pt-20" style="background: #060b17;">

    <!-- Page Header -->
    <section class="relative overflow-hidden" style="background: #060b17;">
      <Image
        src={contactBg}
        alt=""
        aria-hidden="true"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        width={1920}
        height={1080}
        class="absolute inset-0 w-full h-full object-cover"
        style="opacity: 0.35;"
        loading="eager"
      />
      <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(6,11,23,0.15) 0%, rgba(6,11,23,0.55) 100%);"></div>
      <div class="absolute inset-0" aria-hidden="true" style="background-image: linear-gradient(to right, rgba(255,255,255,0.04) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.04) 1px, transparent 1px); background-size: 48px 48px;"></div>
      <div class="relative z-10 max-w-4xl mx-auto px-5 lg:px-12 py-28 sm:py-36 lg:py-44">
        <div class="font-mono text-[11px] tracking-[0.18em] uppercase flex items-center gap-2.5 mb-6" style="color: #2cb7e8;">
          <span style="opacity:0.7">01</span>
          <span class="inline-block w-6 h-px bg-current opacity-50"></span>
          <span>Contact</span>
        </div>
        <h1 class="font-display font-semibold text-white leading-tight" style="font-size: clamp(36px, 5vw, 64px); letter-spacing: -0.035em; margin: 0 0 24px;">Let's Talk</h1>
        <p class="text-[17px] leading-relaxed max-w-2xl" style="color: rgba(255,255,255,0.65);">Tell us about your project. We respond within one business day.</p>
      </div>
    </section>

    <!-- Form Section -->
    <section class="relative overflow-hidden py-16 sm:py-20 lg:py-24" style="background: var(--t-bg-card);">
      <div class="max-w-2xl mx-auto px-5 lg:px-12">
        <form
          id="contact-form"
          data-form="contact"
          class="space-y-5 p-5 sm:p-8"
          style="background: var(--t-bg-card); border: 1px solid var(--t-border);"
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-[11px] font-mono tracking-[0.14em] uppercase mb-2" for="first-name" style="color: var(--t-muted);">First Name <span style="color: #2cb7e8;">*</span></label>
              <input id="first-name" name="first_name" type="text" required placeholder="Jane" value={prefill.first_name}
                class="w-full px-4 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#2cb7e8]"
                style="color: var(--t-heading); background: var(--t-bg-section); border: 1px solid var(--t-border);" />
            </div>
            <div>
              <label class="block text-[11px] font-mono tracking-[0.14em] uppercase mb-2" for="last-name" style="color: var(--t-muted);">Last Name <span style="color: #2cb7e8;">*</span></label>
              <input id="last-name" name="last_name" type="text" required placeholder="Smith" value={prefill.last_name}
                class="w-full px-4 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#2cb7e8]"
                style="color: var(--t-heading); background: var(--t-bg-section); border: 1px solid var(--t-border);" />
            </div>
          </div>

          <div>
            <label class="block text-[11px] font-mono tracking-[0.14em] uppercase mb-2" for="email" style="color: var(--t-muted);">Email <span style="color: #2cb7e8;">*</span></label>
            <input id="email" name="email" type="email" required placeholder="jane@company.com" value={prefill.email}
              class="w-full px-4 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#2cb7e8]"
              style="color: var(--t-heading); background: var(--t-bg-section); border: 1px solid var(--t-border);" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-[11px] font-mono tracking-[0.14em] uppercase mb-2" for="country" style="color: var(--t-muted);">Country</label>
              <input id="country" name="country" type="text" placeholder="United States" value={prefill.country}
                class="w-full px-4 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#2cb7e8]"
                style="color: var(--t-heading); background: var(--t-bg-section); border: 1px solid var(--t-border);" />
            </div>
            <div>
              <label class="block text-[11px] font-mono tracking-[0.14em] uppercase mb-2" for="company" style="color: var(--t-muted);">Company</label>
              <input id="company" name="company" type="text" placeholder="Acme Corp" value={prefill.company}
                class="w-full px-4 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#2cb7e8]"
                style="color: var(--t-heading); background: var(--t-bg-section); border: 1px solid var(--t-border);" />
            </div>
          </div>

          <div>
            <label class="block text-[11px] font-mono tracking-[0.14em] uppercase mb-2" for="job-title" style="color: var(--t-muted);">Job Title</label>
            <input id="job-title" name="job_title" type="text" placeholder="VP of Engineering" value={prefill.job_title}
              class="w-full px-4 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#2cb7e8]"
              style="color: var(--t-heading); background: var(--t-bg-section); border: 1px solid var(--t-border);" />
          </div>

          <div>
            <label class="block text-[11px] font-mono tracking-[0.14em] uppercase mb-2" for="industry" style="color: var(--t-muted);">Industry</label>
            <select id="industry" name="industry"
              class="w-full px-4 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#2cb7e8]"
              style="color: var(--t-heading); background: var(--t-bg-section); border: 1px solid var(--t-border);">
              <option value="" style="background: var(--t-bg-card);">Select your industry...</option>
              {industries.map(ind => <option value={ind} selected={prefill.industry === ind} style="background: var(--t-bg-card);">{ind}</option>)}
            </select>
          </div>

          <div>
            <label class="block text-[11px] font-mono tracking-[0.14em] uppercase mb-2" for="interest" style="color: var(--t-muted);">I'm interested in</label>
            <select id="interest" name="interest"
              class="w-full px-4 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#2cb7e8]"
              style="color: var(--t-heading); background: var(--t-bg-section); border: 1px solid var(--t-border);">
              <option value="" style="background: var(--t-bg-card);">Select a service...</option>
              {interests.map(i => <option value={i} selected={prefill.interest === i} style="background: var(--t-bg-card);">{i}</option>)}
            </select>
          </div>

          <div>
            <label class="block text-[11px] font-mono tracking-[0.14em] uppercase mb-2" for="notes" style="color: var(--t-muted);">Additional Notes</label>
            <textarea id="notes" name="notes" rows="4" placeholder="What are you building? What's the challenge? What have you tried?"
              class="w-full px-4 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#2cb7e8] resize-none"
              style="color: var(--t-heading); background: var(--t-bg-section); border: 1px solid var(--t-border);">{prefill.notes}</textarea>
          </div>

          <div class="flex items-start gap-3">
            <input id="terms" name="terms" type="checkbox" required
              class="mt-1 h-4 w-4 focus:ring-[#2cb7e8] focus:ring-offset-0"
              style="accent-color: #1478c8;" />
            <label for="terms" class="text-sm leading-relaxed" style="color: var(--t-muted);">
              I agree to the <a href="/privacy" style="color: #2cb7e8;" class="hover:underline">Privacy Policy</a> and <a href="/terms" style="color: #2cb7e8;" class="hover:underline">Terms of Service</a>.
            </label>
          </div>

          <button type="submit"
            class="w-full py-4 text-white font-semibold text-sm hover:opacity-90 transition-opacity"
            style="background: #1478c8;">
            Send Message
          </button>
        </form>

        <p class="text-center text-sm mt-6" style="color: var(--t-muted);">
          Or email us at <a href={`mailto:${CONTACT_EMAIL}`} style="color: #2cb7e8;" class="hover:underline">{CONTACT_EMAIL}</a>
        </p>
      </div>
    </section>

  </main>
</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const btn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !btn) return;

    const data = new FormData(form);
    const payload = Object.fromEntries(data.entries());

    btn.disabled = true;
    btn.textContent = 'Sending…';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        form.reset();
        btn.textContent = 'Message sent!';
        btn.style.background = '#16a34a';
      } else {
        btn.textContent = 'Something went wrong — try again';
        btn.style.background = '#dc2626';
        btn.disabled = false;
      }
    } catch {
      btn.textContent = 'Network error — try again';
      btn.style.background = '#dc2626';
      btn.disabled = false;
    }
  });
</script>
