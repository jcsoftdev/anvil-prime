---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navigation/Navbar.astro';
import ScrollReveal from '../../components/Animations/ScrollReveal.astro';
import Button from '../../components/UI/Button.astro';

const useCases = [
  { title: 'Vertical-Specific Models', description: 'Foundation models fine-tuned on domain data — medical records, financial filings, media metadata.' },
  { title: 'Domain Data Pipelines', description: 'ETL and feature engineering pipelines purpose-built for industry data formats and compliance.' },
  { title: 'Compliance-Ready Deployments', description: 'AI systems designed for HIPAA, SOC 2, PCI-DSS, and sector-specific regulatory frameworks.' },
  { title: 'Industry Benchmark Evaluation', description: 'Continuous evaluation against domain-specific benchmarks to ensure model quality at scale.' },
];
---

<Base title="Industry AI" description="Applied AI solutions for Media, Banking, Healthcare, and Retail enterprises.">
  <Navbar />
  <main class="pt-24 pb-20">
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <ScrollReveal>
        <a href="/services" class="text-accent text-sm font-medium hover:underline">← What We Do</a>
        <h1 class="text-4xl sm:text-5xl font-bold text-heading mt-6 mb-6">Industry AI</h1>
        <p class="text-xl text-secondary leading-relaxed max-w-2xl">
          Transforming industry-specific use cases with Applied AI solutions that are built for your vertical — not generic demos repackaged as products.
        </p>
      </ScrollReveal>
    </section>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
      <div class="grid sm:grid-cols-2 gap-6">
        {useCases.map((uc, i) => {
          const DELAYS = [0, 100, 200, 300] as const;
          return (
            <ScrollReveal delay={DELAYS[i]}>
              <div class="bg-base-alt rounded-xl p-6 border border-border">
                <h3 class="font-bold text-heading mb-2">{uc.title}</h3>
                <p class="text-secondary text-sm leading-relaxed">{uc.description}</p>
              </div>
            </ScrollReveal>
          );
        })}
      </div>
    </section>

    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
      <ScrollReveal>
        <h2 class="text-3xl font-bold text-heading mb-4">Ready to Apply AI to Your Industry?</h2>
        <p class="text-secondary text-lg mb-8">Tell us your vertical and challenge. We'll scope an engagement in one call.</p>
        <Button href="/contact" variant="primary" size="lg">Get in Touch</Button>
      </ScrollReveal>
    </section>
  </main>
</Base>
