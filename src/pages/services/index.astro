---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navigation/Navbar.astro';
import ScrollReveal from '../../components/Animations/ScrollReveal.astro';
import Button from '../../components/UI/Button.astro';
import { Image } from 'astro:assets';
import servicesBg from '../../assets/images/services.jpg';

const services = [
  {
    title: 'Industry AI',
    href: '/services/industry-ai',
    tagline: 'Applied AI for your vertical',
    description: 'Transforming industry-specific use cases with Applied AI solutions that drive measurable outcomes for enterprises.',
    capabilities: ['Vertical-specific AI models', 'Domain data pipelines', 'Compliance-ready deployments', 'Industry benchmark evaluation'],
  },
  {
    title: 'Workflows AI',
    href: '/services/workflows-ai',
    tagline: 'Agentic systems at enterprise scale',
    description: 'Building agentic systems that unify workflows and multiply team performance — from ideation to production.',
    capabilities: ['Multi-agent orchestration', 'Process automation', 'Human-in-the-loop design', 'Enterprise integration'],
  },
  {
    title: 'SDLC AI',
    href: '/services/sdlc-ai',
    tagline: 'AI-native product engineering',
    description: 'Accelerating software product engineering with agentic pods across the full software development lifecycle.',
    capabilities: ['AI-assisted development', 'Automated testing & QA', 'Intelligent code review', 'DevOps acceleration'],
  },
];
---

<Base title="What We Do" description="Applied AI solutions — Industry AI, Workflows AI, and SDLC AI — that drive measurable outcomes for enterprises.">
  <Navbar />
  <main class="pt-24 pb-20">
    <section class="relative overflow-hidden bg-slate-900">
      <Image
        src={servicesBg}
        alt=""
        aria-hidden="true"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        width={1920}
        height={1080}
        class="absolute inset-0 w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-slate-900/65" />
      <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center">
        <ScrollReveal>
          <span class="text-accent-bright font-semibold text-sm uppercase tracking-wider">What We Do</span>
          <h1 class="text-4xl sm:text-5xl font-bold text-white mt-4 mb-6">AI That Ships.</h1>
          <p class="text-xl text-white/70 max-w-2xl mx-auto leading-relaxed">
            We build applied AI solutions across three practice areas — all engineered to production standards, not prototypes.
          </p>
        </ScrollReveal>
      </div>
    </section>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
      <div class="grid lg:grid-cols-3 gap-8">
        {services.map((service, i) => {
          const DELAYS = [0, 100, 200] as const;
          return (
            <ScrollReveal delay={DELAYS[i]}>
              <a href={service.href} class="block h-full bg-base border border-border rounded-xl p-8 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 group">
                <div class="w-12 h-12 bg-accent-light rounded-xl flex items-center justify-center mb-6">
                  <div class="w-6 h-6 bg-accent rounded" />
                </div>
                <div class="text-xs font-semibold text-accent uppercase tracking-wider mb-2">{service.tagline}</div>
                <h2 class="text-2xl font-bold text-heading mb-3 group-hover:text-accent transition-colors">{service.title}</h2>
                <p class="text-secondary leading-relaxed mb-6">{service.description}</p>
                <ul class="space-y-2">
                  {service.capabilities.map(cap => (
                    <li class="flex items-center gap-2 text-sm text-muted">
                      <span class="h-1.5 w-1.5 rounded-full bg-accent flex-none" />
                      {cap}
                    </li>
                  ))}
                </ul>
              </a>
            </ScrollReveal>
          );
        })}
      </div>

      <ScrollReveal class="mt-16 text-center">
        <Button href="/contact" variant="primary" size="lg">Talk to Our Team</Button>
      </ScrollReveal>
    </div>
  </main>
</Base>
