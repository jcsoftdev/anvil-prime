---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navigation/Navbar.astro';

const services = [
  {
    title: 'Industry AI',
    href: '/services/industry-ai',
    tagline: 'Applied AI for your vertical',
    description: 'Transforming industry-specific use cases with Applied AI solutions that drive measurable outcomes for enterprises.',
    capabilities: ['Vertical-specific AI models', 'Domain data pipelines', 'Compliance-ready deployments', 'Industry benchmark evaluation'],
  },
  {
    title: 'Workflows AI',
    href: '/services/workflows-ai',
    tagline: 'Agentic systems at enterprise scale',
    description: 'Building agentic systems that unify workflows and multiply team performance — from ideation to production.',
    capabilities: ['Multi-agent orchestration', 'Process automation', 'Human-in-the-loop design', 'Enterprise integration'],
  },
  {
    title: 'SDLC AI',
    href: '/services/sdlc-ai',
    tagline: 'AI-native product engineering',
    description: 'Accelerating software product engineering with agentic pods across the full software development lifecycle.',
    capabilities: ['AI-assisted development', 'Automated testing & QA', 'Intelligent code review', 'DevOps acceleration'],
  },
];
---

<Base title="What We Do" description="Applied AI solutions — Industry AI, Workflows AI, and SDLC AI — that drive measurable outcomes for enterprises.">
  <Navbar />
  <main class="pt-20" style="background: #060b17;">

    <section style="background: #060b17; padding: 160px 0 100px; position: relative; overflow: hidden;">
      <div class="absolute inset-0" aria-hidden="true" style="background-image: linear-gradient(to right, rgba(255,255,255,0.04) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.04) 1px, transparent 1px); background-size: 48px 48px;"></div>
      <div class="max-w-4xl mx-auto px-6 lg:px-12 relative">
        <div class="font-mono text-[11px] tracking-[0.18em] uppercase flex items-center gap-2.5 mb-6" style="color: #2cb7e8;">
          <span style="opacity:0.7">03</span>
          <span class="inline-block w-6 h-px bg-current opacity-50"></span>
          <span>What We Do</span>
        </div>
        <h1 class="font-display font-semibold text-white leading-tight" style="font-size: clamp(36px, 5vw, 64px); letter-spacing: -0.035em; margin: 0 0 24px;">AI That Ships.</h1>
        <p class="text-[17px] leading-relaxed max-w-2xl" style="color: rgba(255,255,255,0.65);">
          We build applied AI solutions across three practice areas — all engineered to production standards, not prototypes.
        </p>
      </div>
    </section>

    <section style="background: #0b1322; padding: 80px 0;">
      <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-3 gap-6">
          {services.map((service) => (
            <a href={service.href} class="group flex flex-col border transition-transform duration-200 hover:-translate-y-1 relative" style="border-color: rgba(255,255,255,0.08); background: #0b1322; padding: 36px; text-decoration: none; color: inherit;">
              <div class="absolute top-0 left-0 h-0.5 transition-all duration-300" style="width: 48px; background: #2cb7e8;" data-accent-bar></div>
              <div class="font-mono text-[10px] tracking-[0.16em] uppercase mb-3" style="color: #1478c8;">{service.tagline}</div>
              <h2 class="font-display font-semibold text-white mb-4 group-hover:text-[#2cb7e8] transition-colors" style="font-size: 26px; letter-spacing: -0.02em;">{service.title}</h2>
              <p class="text-[14px] leading-relaxed mb-6 flex-1" style="color: rgba(255,255,255,0.65);">{service.description}</p>
              <ul class="space-y-2">
                {service.capabilities.map(cap => (
                  <li class="flex items-center gap-2 font-mono text-[10px] tracking-[0.1em] uppercase" style="color: rgba(255,255,255,0.45);">
                    <span class="h-px w-4 flex-none opacity-60" style="background: #2cb7e8;"></span>
                    {cap}
                  </li>
                ))}
              </ul>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section style="background: #060b17; padding: 80px 0;">
      <div class="max-w-3xl mx-auto px-6 lg:px-12 text-center">
        <h2 class="font-display font-semibold text-white mb-4" style="font-size: clamp(28px, 4vw, 48px); letter-spacing: -0.03em;">Ready to build?</h2>
        <p class="text-[16px] mb-8" style="color: rgba(255,255,255,0.65);">Tell us about your project.</p>
        <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold text-white transition-colors" style="background: #1478c8;">
          Get in Touch
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
        </a>
      </div>
    </section>

  </main>
</Base>

<script>
  document.querySelectorAll('[data-accent-bar]').forEach(bar => {
    const card = bar.closest('a');
    if (!card) return;
    card.addEventListener('mouseenter', () => { (bar as HTMLElement).style.width = '100%'; });
    card.addEventListener('mouseleave', () => { (bar as HTMLElement).style.width = '48px'; });
  });
</script>
