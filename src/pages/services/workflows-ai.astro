---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navigation/Navbar.astro';
import { Image } from 'astro:assets';
import workflowsAiBg from '../../assets/images/service-workflows-ai.jpg';

const useCases = [
  { title: 'Multi-Agent Orchestration', description: 'Design and deploy coordinated agent networks that reason, delegate, and execute complex multi-step tasks.' },
  { title: 'Process Automation', description: 'Replace manual, repetitive workflows with intelligent agents that adapt to exceptions and edge cases.' },
  { title: 'Human-in-the-Loop Design', description: 'Build trust into agentic systems with approval gates, audit trails, and human oversight where it matters.' },
  { title: 'Enterprise Integration', description: 'Connect agents to your existing ERP, CRM, and data systems without ripping out infrastructure.' },
];
---

<Base title="Workflows AI" description="Building agentic systems that unify workflows and multiply team performance — from ideation to production.">
  <Navbar />
  <main class="pt-20" style="background: #060b17;">

    <section class="relative overflow-hidden" style="background: #060b17;">
      <Image
        src={workflowsAiBg}
        alt=""
        aria-hidden="true"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        width={1920}
        height={1080}
        class="absolute inset-0 w-full h-full object-cover"
        style="opacity: 0.35;"
        loading="eager"
      />
      <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(6,11,23,0.15) 0%, rgba(6,11,23,0.55) 100%);"></div>
      <div class="absolute inset-0" aria-hidden="true" style="background-image: linear-gradient(to right, rgba(255,255,255,0.04) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.04) 1px, transparent 1px); background-size: 48px 48px;"></div>
      <div class="relative z-10 max-w-4xl mx-auto px-5 lg:px-12 py-28 sm:py-36 lg:py-44">
        <a href="/services" class="font-mono text-[11px] tracking-[0.14em] uppercase hover:underline flex items-center gap-2 mb-8" style="color: #2cb7e8; opacity: 0.8; text-decoration: none;">
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M13 8H3M7 12l-4-4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
          What We Do
        </a>
        <div class="font-mono text-[10px] tracking-[0.16em] uppercase mb-6" style="color: #1478c8;">Agentic systems at enterprise scale</div>
        <h1 class="font-display font-semibold text-white leading-tight" style="font-size: clamp(36px, 5vw, 64px); letter-spacing: -0.035em; margin: 0 0 24px;">Workflows AI</h1>
        <p class="text-[17px] leading-relaxed max-w-2xl" style="color: rgba(255,255,255,0.65);">
          Building agentic systems that unify workflows and multiply team performance — from ideation to production.
        </p>
      </div>
    </section>

    <section class="py-16 sm:py-20 lg:py-24" style="background: var(--t-bg-card);">
      <div class="max-w-7xl mx-auto px-5 lg:px-12">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
          {useCases.map((uc) => (
            <div class="border p-8" style="background: var(--t-bg-card); border-color: var(--t-border);">
              <div class="h-0.5 mb-6" style="width: 32px; background: #2cb7e8;"></div>
              <h3 class="font-display font-semibold mb-3" style="font-size: 18px; color: var(--t-heading);">{uc.title}</h3>
              <p class="text-[14px] leading-relaxed" style="color: var(--t-body);">{uc.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 sm:py-20" style="background: var(--t-bg-section);">
      <div class="max-w-3xl mx-auto px-5 lg:px-12 text-center">
        <h2 class="font-display font-semibold mb-4" style="font-size: clamp(28px, 4vw, 48px); letter-spacing: -0.03em; color: var(--t-heading);">Ready to build?</h2>
        <p class="text-[16px] mb-8" style="color: var(--t-body);">Tell us your workflow challenge. We'll scope an engagement in one call.</p>
        <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold text-white transition-colors" style="background: #1478c8;">
          Get in Touch
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
        </a>
      </div>
    </section>

  </main>
</Base>
