---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navigation/Navbar.astro';
import ScrollReveal from '../../components/Animations/ScrollReveal.astro';
import Button from '../../components/UI/Button.astro';
import { Image } from 'astro:assets';
import workflowsAiBg from '../../assets/images/service-workflows-ai.jpg';

const useCases = [
  { title: 'Multi-Agent Orchestration', description: 'Design and deploy coordinated agent networks that reason, delegate, and execute complex multi-step tasks.' },
  { title: 'Process Automation', description: 'Replace manual, repetitive workflows with intelligent agents that adapt to exceptions and edge cases.' },
  { title: 'Human-in-the-Loop Design', description: 'Build trust into agentic systems with approval gates, audit trails, and human oversight where it matters.' },
  { title: 'Enterprise Integration', description: 'Connect agents to your existing ERP, CRM, and data systems without ripping out infrastructure.' },
];
---

<Base title="Workflows AI" description="Building agentic systems that unify workflows and multiply team performance — from ideation to production.">
  <Navbar />
  <main class="pt-24 pb-20">
    <section class="relative overflow-hidden bg-slate-900">
      <Image
        src={workflowsAiBg}
        alt=""
        aria-hidden="true"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        width={1920}
        height={1080}
        class="absolute inset-0 w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-slate-900/65" />
      <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
        <ScrollReveal>
          <a href="/services" class="text-accent-bright text-sm font-medium hover:underline">← What We Do</a>
          <h1 class="text-4xl sm:text-5xl font-bold text-white mt-6 mb-6">Workflows AI</h1>
          <p class="text-xl text-white/70 leading-relaxed max-w-2xl">
            Building agentic systems that unify workflows and multiply team performance — from ideation to production.
          </p>
        </ScrollReveal>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
      <div class="grid sm:grid-cols-2 gap-6">
        {useCases.map((uc, i) => {
          const DELAYS = [0, 100, 200, 300] as const;
          return (
            <ScrollReveal delay={DELAYS[i]}>
              <div class="bg-base-alt rounded-xl p-6 border border-border">
                <h3 class="font-bold text-heading mb-2">{uc.title}</h3>
                <p class="text-secondary text-sm leading-relaxed">{uc.description}</p>
              </div>
            </ScrollReveal>
          );
        })}
      </div>
    </section>

    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
      <ScrollReveal>
        <h2 class="text-3xl font-bold text-heading mb-4">Ready to Unify Your Workflows with AI?</h2>
        <p class="text-secondary text-lg mb-8">Tell us your workflow challenge. We'll scope an engagement in one call.</p>
        <Button href="/contact" variant="primary" size="lg">Get in Touch</Button>
      </ScrollReveal>
    </section>
  </main>
</Base>
