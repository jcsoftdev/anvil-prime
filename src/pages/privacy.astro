---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navigation/Navbar.astro';
---

<Base title="Privacy Policy" description="Privacy Policy for Anvil Prime.">
  <Navbar />
  <main class="pt-20" style="background: #060b17;">

    <!-- Page Header -->
    <section style="background: #060b17; padding: 160px 0 80px; position: relative; overflow: hidden;">
      <div class="absolute inset-0" aria-hidden="true" style="background-image: linear-gradient(to right, rgba(255,255,255,0.04) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.04) 1px, transparent 1px); background-size: 48px 48px;"></div>
      <div class="max-w-4xl mx-auto px-6 lg:px-12 relative">
        <div class="font-mono text-[11px] tracking-[0.18em] uppercase flex items-center gap-2.5 mb-6" style="color: #2cb7e8;">
          <span style="opacity:0.7">01</span>
          <span class="inline-block w-6 h-px bg-current opacity-50"></span>
          <span>Legal</span>
        </div>
        <h1 class="font-display font-semibold text-white leading-tight" style="font-size: clamp(36px, 5vw, 64px); letter-spacing: -0.035em; margin: 0 0 24px;">Privacy Policy</h1>
        <p class="text-[17px] leading-relaxed max-w-2xl" style="color: rgba(255,255,255,0.65);">How we collect, use, and protect your information.</p>
      </div>
    </section>

    <!-- Content -->
    <section style="background: #0b1322; padding: 80px 0 120px;">
      <div
        class="max-w-3xl mx-auto px-6 lg:px-12 [&_h2]:text-white [&_h2]:font-display [&_h2]:text-xl [&_h2]:mt-8 [&_h2]:mb-3 [&_p]:mb-4 [&_p]:text-[15px] [&_a]:hover:underline"
        style="color: rgba(255,255,255,0.65); line-height: 1.7;"
      >
        <p>This page is coming soon.</p>
      </div>
    </section>

  </main>
</Base>
