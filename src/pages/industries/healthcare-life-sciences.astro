---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navigation/Navbar.astro';
import ScrollReveal from '../../components/Animations/ScrollReveal.astro';
import Button from '../../components/UI/Button.astro';

const solutions = [
  { title: 'Preventative Health', description: 'Risk stratification models that identify high-risk patients before acute events, enabling proactive intervention.' },
  { title: 'Diagnostics', description: 'AI-assisted diagnostic tools for imaging, lab results, and clinical notes that augment clinician decision-making.' },
  { title: 'Research & Drug Discovery', description: 'ML pipelines that accelerate compound screening, trial design, and biomarker identification.' },
  { title: 'Facility Operations', description: 'Intelligent scheduling, capacity management, and supply chain optimization for health systems.' },
];
---

<Base title="Healthcare & Life Sciences AI" description="Applied AI for preventative health, diagnostics, research, and facility operations.">
  <Navbar />
  <main class="pt-24 pb-20">
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <ScrollReveal>
        <a href="/industries" class="text-accent text-sm font-medium hover:underline">← Industries</a>
        <h1 class="text-4xl sm:text-5xl font-bold text-heading mt-6 mb-6">Healthcare & Life Sciences</h1>
        <p class="text-xl text-secondary leading-relaxed max-w-2xl">
          AI built for the most regulated, most consequential industry — where accuracy and compliance aren't optional.
        </p>
      </ScrollReveal>
    </section>
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
      <div class="grid sm:grid-cols-2 gap-6">
        {solutions.map((s, i) => {
          const DELAYS = [0, 100, 200, 300] as const;
          return (
            <ScrollReveal delay={DELAYS[i]}>
              <div class="bg-base-alt rounded-xl p-6 border border-border h-full">
                <h3 class="font-bold text-heading mb-2">{s.title}</h3>
                <p class="text-secondary text-sm leading-relaxed">{s.description}</p>
              </div>
            </ScrollReveal>
          );
        })}
      </div>
    </section>
    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 text-center">
      <ScrollReveal>
        <Button href="/contact" variant="primary" size="lg">Talk to a Healthcare AI Expert</Button>
      </ScrollReveal>
    </section>
  </main>
</Base>
