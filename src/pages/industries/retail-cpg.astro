---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navigation/Navbar.astro';
import ScrollReveal from '../../components/Animations/ScrollReveal.astro';
import Button from '../../components/UI/Button.astro';
import { Image } from 'astro:assets';
import retailBg from '../../assets/images/industry-retail.jpg';

const solutions = [
  { title: 'Supply Chain Optimization', description: 'End-to-end supply chain visibility and AI-driven optimization from procurement to last-mile delivery.' },
  { title: 'Demand Forecasting', description: 'ML models that predict demand at SKU-level across channels, reducing overstock and stockouts.' },
  { title: 'Omni-Channel Retail', description: 'Unified customer intelligence across e-commerce, in-store, and marketplace channels.' },
];
---

<Base title="Retail & CPG AI" description="Applied AI for supply chain optimization, demand forecasting, and omni-channel retail.">
  <Navbar />
  <main class="pt-24 pb-20">
    <section class="relative overflow-hidden bg-slate-900">
      <Image
        src={retailBg}
        alt=""
        aria-hidden="true"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        width={1920}
        height={1080}
        class="absolute inset-0 w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-slate-900/65" />
      <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
        <ScrollReveal>
          <a href="/industries" class="text-accent-bright text-sm font-medium hover:underline">← Industries</a>
          <h1 class="text-4xl sm:text-5xl font-bold text-white mt-6 mb-6">Retail & CPG</h1>
          <p class="text-xl text-white/70 leading-relaxed max-w-2xl">
            AI that turns data from your shelves, supply chain, and customers into a durable competitive edge.
          </p>
        </ScrollReveal>
      </div>
    </section>
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
      <div class="grid sm:grid-cols-3 gap-6">
        {solutions.map((s, i) => {
          const DELAYS = [0, 100, 200] as const;
          return (
            <ScrollReveal delay={DELAYS[i]}>
              <div class="bg-base-alt rounded-xl p-6 border border-border h-full">
                <h3 class="font-bold text-heading mb-2">{s.title}</h3>
                <p class="text-secondary text-sm leading-relaxed">{s.description}</p>
              </div>
            </ScrollReveal>
          );
        })}
      </div>
    </section>
    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 text-center">
      <ScrollReveal>
        <Button href="/contact" variant="primary" size="lg">Talk to a Retail AI Expert</Button>
      </ScrollReveal>
    </section>
  </main>
</Base>
