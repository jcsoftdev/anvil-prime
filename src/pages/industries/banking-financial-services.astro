---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navigation/Navbar.astro';
import ScrollReveal from '../../components/Animations/ScrollReveal.astro';
import Button from '../../components/UI/Button.astro';

const solutions = [
  { title: 'Neo/Hybrid Banking', description: 'Core banking AI for digital-first banks and traditional institutions building hybrid digital products.' },
  { title: 'Document Intelligence', description: 'Extract, classify, and act on structured and unstructured financial documents — contracts, filings, KYC, and more.' },
  { title: 'Financial Workflows', description: 'Agentic systems for loan origination, underwriting, claims processing, and reconciliation.' },
];
---

<Base title="Banking, Financial Services & Insurance AI" description="Applied AI for neo-banking, document intelligence, and financial workflows.">
  <Navbar />
  <main class="pt-24 pb-20">
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <ScrollReveal>
        <a href="/industries" class="text-accent text-sm font-medium hover:underline">← Industries</a>
        <h1 class="text-4xl sm:text-5xl font-bold text-heading mt-6 mb-6">Banking, Financial Services & Insurance</h1>
        <p class="text-xl text-secondary leading-relaxed max-w-2xl">
          From neo-banking infrastructure to document intelligence — AI that meets the compliance bar while moving at startup speed.
        </p>
      </ScrollReveal>
    </section>
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
      <div class="grid sm:grid-cols-3 gap-6">
        {solutions.map((s, i) => {
          const DELAYS = [0, 100, 200] as const;
          return (
            <ScrollReveal delay={DELAYS[i]}>
              <div class="bg-base-alt rounded-xl p-6 border border-border h-full">
                <h3 class="font-bold text-heading mb-2">{s.title}</h3>
                <p class="text-secondary text-sm leading-relaxed">{s.description}</p>
              </div>
            </ScrollReveal>
          );
        })}
      </div>
    </section>
    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 text-center">
      <ScrollReveal>
        <Button href="/contact" variant="primary" size="lg">Talk to a Financial AI Expert</Button>
      </ScrollReveal>
    </section>
  </main>
</Base>
