---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navigation/Navbar.astro';

const solutions = [
  { title: 'Neo/Hybrid Banking', description: 'Core banking AI for digital-first banks and traditional institutions building hybrid digital products.' },
  { title: 'Document Intelligence', description: 'Extract, classify, and act on structured and unstructured financial documents — contracts, filings, KYC, and more.' },
  { title: 'Financial Workflows', description: 'Agentic systems for loan origination, underwriting, claims processing, and reconciliation.' },
];
---

<Base title="Banking, Financial Services & Insurance AI" description="Applied AI for neo-banking, document intelligence, and financial workflows.">
  <Navbar />
  <main class="pt-20" style="background: #060b17;">

    <section style="background: #060b17; padding: 160px 0 100px; position: relative; overflow: hidden;">
      <div class="absolute inset-0" aria-hidden="true" style="background-image: linear-gradient(to right, rgba(255,255,255,0.04) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.04) 1px, transparent 1px); background-size: 48px 48px;"></div>
      <div class="max-w-4xl mx-auto px-6 lg:px-12 relative">
        <a href="/industries" class="font-mono text-[11px] tracking-[0.14em] uppercase hover:underline flex items-center gap-2 mb-8" style="color: #2cb7e8; opacity: 0.8; text-decoration: none;">
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M13 8H3M7 12l-4-4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
          Industries
        </a>
        <h1 class="font-display font-semibold text-white leading-tight" style="font-size: clamp(36px, 5vw, 64px); letter-spacing: -0.035em; margin: 0 0 24px;">Banking, Financial Services & Insurance</h1>
        <p class="text-[17px] leading-relaxed max-w-2xl" style="color: rgba(255,255,255,0.65);">
          From neo-banking infrastructure to document intelligence — AI that meets the compliance bar while moving at startup speed.
        </p>
      </div>
    </section>

    <section style="background: #0b1322; padding: 80px 0;">
      <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {solutions.map((s) => (
            <div class="border p-8" style="background: #0b1322; border-color: rgba(255,255,255,0.08);">
              <div class="h-0.5 mb-6" style="width: 32px; background: #2cb7e8;"></div>
              <h3 class="font-display font-semibold text-white mb-3" style="font-size: 18px;">{s.title}</h3>
              <p class="text-[14px] leading-relaxed" style="color: rgba(255,255,255,0.65);">{s.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section style="background: #060b17; padding: 80px 0;">
      <div class="max-w-3xl mx-auto px-6 lg:px-12 text-center">
        <h2 class="font-display font-semibold text-white mb-4" style="font-size: clamp(28px, 4vw, 48px); letter-spacing: -0.03em;">Ready to build?</h2>
        <p class="text-[16px] mb-8" style="color: rgba(255,255,255,0.65);">Tell us about your project.</p>
        <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold text-white transition-colors" style="background: #1478c8;">
          Talk to a Financial AI Expert
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
        </a>
      </div>
    </section>

  </main>
</Base>
