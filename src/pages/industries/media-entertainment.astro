---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navigation/Navbar.astro';
import ScrollReveal from '../../components/Animations/ScrollReveal.astro';
import Button from '../../components/UI/Button.astro';

const solutions = [
  { title: 'Media Supply Chain', description: 'AI-powered ingest, transcoding, quality control, and distribution workflows for video and audio content at scale.' },
  { title: 'Content Monetization', description: 'Intelligent ad placement, dynamic pricing, and subscription optimization models that maximize revenue per viewer.' },
  { title: 'Audience Distribution', description: 'Recommendation engines and content discovery systems that match the right content to the right audience at the right time.' },
];
---

<Base title="Media & Entertainment AI" description="Applied AI for media supply chain, content monetization, and audience distribution.">
  <Navbar />
  <main class="pt-24 pb-20">
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <ScrollReveal>
        <a href="/industries" class="text-accent text-sm font-medium hover:underline">← Industries</a>
        <h1 class="text-4xl sm:text-5xl font-bold text-heading mt-6 mb-6">Media & Entertainment</h1>
        <p class="text-xl text-secondary leading-relaxed max-w-2xl">
          From content supply chains to audience monetization — we build AI systems that help media companies scale what works and cut what doesn't.
        </p>
      </ScrollReveal>
    </section>
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
      <div class="grid sm:grid-cols-3 gap-6">
        {solutions.map((s, i) => {
          const DELAYS = [0, 100, 200] as const;
          return (
            <ScrollReveal delay={DELAYS[i]}>
              <div class="bg-base-alt rounded-xl p-6 border border-border h-full">
                <h3 class="font-bold text-heading mb-2">{s.title}</h3>
                <p class="text-secondary text-sm leading-relaxed">{s.description}</p>
              </div>
            </ScrollReveal>
          );
        })}
      </div>
    </section>
    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 text-center">
      <ScrollReveal>
        <Button href="/contact" variant="primary" size="lg">Talk to a Media AI Expert</Button>
      </ScrollReveal>
    </section>
  </main>
</Base>
