---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navigation/Navbar.astro';
import { Image } from 'astro:assets';
import industriesBg from '../../assets/images/industries.jpg';

const industries = [
  {
    title: 'Media & Entertainment',
    href: '/industries/media-entertainment',
    description: 'Media Supply Chain, Content Monetization, Audience Distribution',
    tags: ['Streaming', 'Content Ops', 'Ad Tech'],
  },
  {
    title: 'Banking, Financial Services & Insurance',
    href: '/industries/banking-financial-services',
    description: 'Neo/Hybrid Banking, Document Intelligence, Financial Workflows',
    tags: ['Neo Banking', 'Compliance', 'Risk AI'],
  },
  {
    title: 'Healthcare & Life Sciences',
    href: '/industries/healthcare-life-sciences',
    description: 'Preventative Health, Diagnostics, Research, Facility Operations',
    tags: ['Clinical AI', 'HIPAA', 'Drug Discovery'],
  },
  {
    title: 'Retail & CPG',
    href: '/industries/retail-cpg',
    description: 'Supply Chain Optimization, Forecasting, Omni-Channel Retail',
    tags: ['Supply Chain', 'Demand AI', 'Omni-Channel'],
  },
];
---

<Base title="Industries" description="Applied AI solutions for Media, Banking, Healthcare, and Retail enterprises.">
  <Navbar />
  <main class="pt-20" style="background: #060b17;">

    <section class="relative overflow-hidden" style="background: #060b17;">
      <Image
        src={industriesBg}
        alt=""
        aria-hidden="true"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        width={1920}
        height={1080}
        class="absolute inset-0 w-full h-full object-cover"
        style="opacity: 0.35;"
        loading="eager"
      />
      <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(6,11,23,0.15) 0%, rgba(6,11,23,0.55) 100%);"></div>
      <div class="absolute inset-0" aria-hidden="true" style="background-image: linear-gradient(to right, rgba(255,255,255,0.04) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.04) 1px, transparent 1px); background-size: 48px 48px;"></div>
      <div class="relative z-10 max-w-4xl mx-auto px-5 lg:px-12 py-28 sm:py-36 lg:py-44">
        <div class="font-mono text-[11px] tracking-[0.18em] uppercase flex items-center gap-2.5 mb-6" style="color: #2cb7e8;">
          <span style="opacity:0.7">05</span>
          <span class="inline-block w-6 h-px bg-current opacity-50"></span>
          <span>Industries</span>
        </div>
        <h1 class="font-display font-semibold text-white leading-tight" style="font-size: clamp(36px, 5vw, 64px); letter-spacing: -0.035em; margin: 0 0 24px;">Built for Your Vertical</h1>
        <p class="text-[17px] leading-relaxed max-w-2xl" style="color: rgba(255,255,255,0.65);">
          We go deep in four industries where AI creates the most durable competitive advantage.
        </p>
      </div>
    </section>

    <section class="py-16 sm:py-20 lg:py-24" style="background: var(--t-bg-card);">
      <div class="max-w-7xl mx-auto px-5 lg:px-12">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
          {industries.map((ind) => (
            <a href={ind.href} class="group flex flex-col border transition-transform duration-200 hover:-translate-y-1 relative" style="border-color: var(--t-border); background: var(--t-bg-card); padding: 36px; text-decoration: none; color: inherit;">
              <div class="absolute top-0 left-0 h-0.5 transition-all duration-300" style="width: 48px; background: #2cb7e8;" data-accent-bar></div>
              <h2 class="font-display font-semibold mb-3 group-hover:text-[#2cb7e8] transition-colors" style="font-size: 22px; letter-spacing: -0.02em; color: var(--t-heading);">{ind.title}</h2>
              <p class="text-[14px] leading-relaxed mb-6 flex-1" style="color: var(--t-body);">{ind.description}</p>
              <div class="flex flex-wrap gap-2">
                {ind.tags.map(tag => (
                  <span class="font-mono text-[10px] tracking-[0.1em] uppercase px-2.5 py-1 border" style="border-color: var(--t-border); color: var(--t-muted);">{tag}</span>
                ))}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 sm:py-20" style="background: var(--t-bg-section);">
      <div class="max-w-3xl mx-auto px-5 lg:px-12 text-center">
        <h2 class="font-display font-semibold mb-4" style="font-size: clamp(28px, 4vw, 48px); letter-spacing: -0.03em; color: var(--t-heading);">Ready to build?</h2>
        <p class="text-[16px] mb-8" style="color: var(--t-body);">Tell us about your project.</p>
        <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold text-white transition-colors" style="background: #1478c8;">
          Get in Touch
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
        </a>
      </div>
    </section>

  </main>
</Base>

<script>
  document.querySelectorAll('[data-accent-bar]').forEach(bar => {
    const card = bar.closest('a');
    if (!card) return;
    card.addEventListener('mouseenter', () => { (bar as HTMLElement).style.width = '100%'; });
    card.addEventListener('mouseleave', () => { (bar as HTMLElement).style.width = '48px'; });
  });
</script>
